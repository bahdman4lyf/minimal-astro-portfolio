  .content-list > :nth-child(2) {
    --reveal-delay: 70ms;
  }
  .content-list > :nth-child(3) {
    --reveal-delay: 140ms;
  }
  .content-list > :nth-child(4) {
    --reveal-delay: 210ms;
  }
  .content-list > :nth-child(n + 5) {
    --reveal-delay: 280ms;
  }
</style>
