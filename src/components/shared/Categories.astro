---
interface Props {
  categories: string[];
  currentPath: string;
  plural?: boolean;
  basePath: string;
}

const { categories, currentPath, plural, basePath } = Astro.props;
const normalized = currentPath.replace(/\/$/, "");
---

<div class="categories" data-reveal style="--reveal-delay: 180ms">
  <a href={`/${basePath}`} class:list={["category-link", { active: normalized === `/${basePath}` }]}>All</a>
  {
    categories.map((category) => (
      <a
        href={`/${basePath}/${category}`}
        class:list={["category-link", { active: normalized === `/${basePath}/${category}` }]}
      >
        {category + (plural ? "s" : "")}
      </a>
    ))
  }
</div>

<style>
  .categories {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .category-link {
    color: var(--text-muted);
    font-size: var(--text-sm);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    text-transform: capitalize;
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }

  .category-link:hover {
    color: var(--text-color);
    border-color: var(--glass-border-strong);
  }

  .category-link.active {
    background: var(--accent-soft);
    border-color: var(--accent-border);
    color: var(--accent);
  }
</style>
