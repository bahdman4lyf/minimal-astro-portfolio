    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.8;
    padding-top: 0.15rem;
  }

  .spec dd {
    margin: 0;
    color: var(--text-color);
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border-radius: 0.5rem;
    border: 1px solid var(--glass-border-strong);
    color: var(--text-color);
    font-size: var(--lp-text-xs);
  }

  .store svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--text-muted);
  }

  .slide-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .slide-count {
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  /* Device stage: a flat, hairline-framed panel with the phone standing in it. */
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 2.5rem 0;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
    perspective: 1600px;
  }

  .stage-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--glass-border-strong);
    border-style: solid;
    border-width: 0;
  }

  .stage-corner.tl {
    top: 14px;
    left: 14px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .stage-corner.tr {
    top: 14px;
    right: 14px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .stage-corner.bl {
    bottom: 14px;
    left: 14px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .stage-corner.br {
    bottom: 14px;
    right: 14px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  /* Oversized index behind the device — typographic, not decorative colour. */
  .stage-num {
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 12vw, 11rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: rgba(255, 255, 255, 0.035);
    user-select: none;
  }

  .stage-label {
    position: absolute;
    left: 1.5rem;
    bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .stage-device {
    position: relative;
    transform-style: preserve-3d;
  }

  :global(.slide-phone) {
    /* Sized by height as well as width so the device always fits the pinned viewport. */
    --phone-w: clamp(170px, min(18vw, 24vh), 250px);
    transform: rotateY(-14deg) rotateX(2deg) scale(0.94);
    opacity: 0.7;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
  }

  .slide.is-active :global(.slide-phone) {
    transform: rotateY(-6deg) rotateX(1deg) scale(1);
    opacity: 1;
  }

  /* Hairline accent along the device's left edge, from the project colour. */
  .stage::after {
    content: "";
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: var(--slide-accent);
    opacity: 0.6;
  }

  /* Controls, in the header row. */
  .showcase-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.35rem;
  }

  .showcase-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-muted);
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base),
      transform var(--transition-base);
  }

  .showcase-btn svg {
    width: 1rem;
    height: 1rem;
  }

  .showcase-btn:hover {
    color: var(--text-color);
    border-color: var(--glass-border-strong);
    background: var(--glass-bg-strong);
    transform: translateY(-1px);
  }

  .showcase-dots {
    display: flex;
    gap: 0.4rem;
  }

  .showcase-dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border-radius: 999px;
    border: 0;
    background: var(--glass-border-strong);
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1), background var(--transition-base);
  }

  .showcase-dot.is-active {
    width: 1.6rem;
    background: var(--accent);
  }

  /* Thin progress line across the top of the pinned viewport. */
  .showcase-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--glass-border);
    z-index: 2;
  }

  .showcase-progress i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ───────────── Timeline ───────────── */
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* The spine. Drawn top-to-bottom as the list scrolls through the viewport. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(11rem + 0.5rem);
    width: 1px;
    background: var(--accent-border);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::before {
        animation: draw-y linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 55%;
      }
    }
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .timeline-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    padding-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .timeline-to {
    opacity: 0.5;
  }

  .timeline-dot {
    position: relative;
    width: 0.65rem;
    height: 0.65rem;
    margin-top: 1.55rem;
    margin-left: 0.2rem;
    border-radius: 50%;
    background: var(--bg-color);
    border: 1px solid var(--accent);
    box-shadow: 0 0 0 4px var(--bg-color);
  }

  .timeline-dot.current {
    background: var(--accent);
  }

  .timeline-dot.current::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse-ring 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .timeline-card {
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-card:hover {
    border-color: var(--glass-border-strong);
    transform: translateX(4px);
  }

  .timeline-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .timeline-title h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .timeline-company {
    font-size: var(--lp-text-sm);
    color: var(--text-muted);
  }

  .timeline-company::before {
    content: "@ ";
    opacity: 0.5;
  }

  .pill-now {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  .timeline-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  /* ───────────── Reviews ───────────── */
  .reviews {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 1100px) and (min-width: 961px) {
    .reviews {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .review {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .review:hover {
    border-color: var(--glass-border-strong);
    transform: translateY(-3px);
  }

  /* Specific enough to beat `[data-spotlight] > *`, which would put it in flow. */
  .review .review-mark {
    position: absolute;
    top: 0.4rem;
    right: 1.25rem;
    font-family: var(--font-serif);
    font-size: 5rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.25;
    pointer-events: none;
  }

  .review blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-color);
    flex: 1;
  }

  .review blockquote p {
    margin: 0;
    max-width: none;
  }

  .review figcaption {
    display: flex;
    align-items: flex-start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--glass-border);
    font-size: var(--lp-text-sm);
  }

  .review-who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.15rem;
    min-width: 0;
  }

  .review-name {
    font-weight: 500;
  }

  .review-role {
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
  }

  .review-role a {
    color: var(--text-muted);
  }

  .review-role a:hover {
    color: var(--accent);
  }

  /* ───────────── Principles ───────────── */
  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--glass-border);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--bg-color);
    background: color-mix(in srgb, var(--bg-color) 85%, transparent);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    transition: background var(--transition-base);
  }

  .principle:hover {
    background: var(--glass-bg-strong);
  }

  .principle-index {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--accent);
  }

  .principle p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  /* ───────────── Skills ───────────── */
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: start;
    gap: 1rem;
  }

  .skill-group + .skill-group {
    padding-top: 1.25rem;
    border-top: 1px solid var(--glass-border);
  }

  .skill-category {
    font-size: var(--lp-text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    opacity: 0.7;
    padding-top: 0.5rem;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Capsules: the radius is deliberately larger than any possible height, so
     the ends stay perfectly semicircular no matter the label length. */
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.4rem 0.95rem;
    font-size: var(--lp-text-sm);
    line-height: 1;
    white-space: nowrap;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    transition: border-color var(--transition-base), background var(--transition-base), color var(--transition-base),
      transform var(--transition-base);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip:hover {
      border-color: var(--accent-border);
      background: var(--accent-soft);
      color: var(--accent);
      transform: translateY(-2px);
    }
  }

  /* ───────────── Writing ───────────── */
  .posts {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--glass-border);
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-color);
    border-radius: 0.5rem;
    transition: background var(--transition-base), padding var(--transition-base);
  }

  .post::after {
    display: none;
  }

  .post:hover {
    background: var(--glass-bg);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .post h3 {
    margin-bottom: 0.3rem;
    transition: color var(--transition-base);
  }

  .post p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .post time {
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .post-arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  .post-arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .post:hover .post-arrow {
    background: var(--text-color);
    color: var(--bg-color);
    transform: translateX(3px);
  }

  /* ───────────── FAQ ───────────── */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem;
    align-items: start;
  }

  .faq-head {
    position: sticky;
    top: 6rem;
    margin-bottom: 0;
  }

  .faq-lede {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
    max-width: 30ch;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base);
  }

  .faq-item[open],
  .faq-item:hover {
    border-color: var(--glass-border-strong);
  }

  .faq-q {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-index {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--accent);
  }

  .faq-chevron {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background var(--transition-base), color var(--transition-base);
  }

  .faq-chevron svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(45deg);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .faq-a {
    overflow: hidden;
    padding: 0 1.35rem;
  }

  .faq-a p {
    margin: 0;
    padding: 0 0 1.35rem 2.35rem;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  /* ───────────── Contact ───────────── */
  .contact {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    overflow: hidden;
    /* Reset the shared spotlight so the border glow below can own --mx/--my. */
    --mx: 50%;
    --my: 50%;
  }

  /* Border glow that follows the pointer: a gradient layer masked to the 1px
     edge of the card, so only the border lights up near the cursor. */
  /* Specific enough to beat `[data-spotlight] > *`, which would otherwise pull
     this layer into the grid as a cell. */
  .contact .contact-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(167, 139, 250, 0.9), transparent 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .contact:hover .contact-glow {
    opacity: 1;
  }

  /* The card's own spotlight is softer than the default so the form stays legible. */
  .contact::before {
    background: radial-gradient(520px circle at var(--mx) var(--my), rgba(167, 139, 250, 0.07), transparent 45%);
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    max-width: 14ch;
    margin: 0 0 1rem;
  }

  .contact-desc {
    color: var(--text-muted);
    margin: 0 0 1.75rem;
    max-width: 40ch;
  }

  /* Email row */
  .contact-email {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    min-width: 0;
  }

  .contact-email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--text-color);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    letter-spacing: -0.01em;
  }

  .contact-email-link::after {
    display: none;
  }

  .contact-email-at {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    font-size: 0.85rem;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-email-link:hover .contact-email-at {
    transform: rotate(-12deg) scale(1.08);
  }

  .contact-email-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Underline slides in from the left on hover. */
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left bottom / 0 1px;
    transition: background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 1px;
  }

  .contact-email-link:hover .contact-email-text {
    background-size: 100% 1px;
  }

  .contact-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-muted);
    font-size: var(--lp-text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--transition-base), background var(--transition-base), color var(--transition-base);
  }

  .contact-copy svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .contact-copy-check {
    display: none;
  }

  .contact-copy:hover {
    border-color: var(--glass-border-strong);
    color: var(--text-color);
  }

  .contact-copy.is-copied {
    border-color: rgba(74, 222, 128, 0.5);
    background: rgba(74, 222, 128, 0.1);
    color: #bbf7d0;
  }

  .contact-copy.is-copied .contact-copy-icon {
    display: none;
  }

  .contact-copy.is-copied .contact-copy-check {
    display: block;
    animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
    transform: none !important;
  }

  .contact-copy.is-copied .contact-copy-label::after {
    content: "ied";
  }

  .contact-copy.is-copied .contact-copy-label {
