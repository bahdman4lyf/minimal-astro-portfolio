---
import Section from "../components/ui/Section.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import PhoneMock from "../components/ui/PhoneMock.astro";
// `?url` makes Vite emit the file as a build asset and hand back its public path.
import resumeUrl from "../assets/docs/Nathaniel Joseph - Frontend- CV.docx?url";

const siteConfig = await getEntry("site", "home");
if (!siteConfig) {
  throw new Error("Site configuration not found");
}

const site = siteConfig.data;

const formatDate = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
};

const formatMonthYear = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

// Staggers a list so items cascade in rather than appearing all at once.
const revealDelay = (index: number, step = 80) => `--reveal-delay: ${index * step}ms`;

// Zero-padded section counter for the "01 — What I do" kickers.
const pad = (n: number) => String(n).padStart(2, "0");

const posts = await getCollection("blog", ({ data }: CollectionEntry<"blog">) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const latestPosts = posts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  )
  .slice(0, 3);

const experiences = await getCollection("experience");
// Current roles first, then most recently started. Several roles share a start
// month, so fall back to end date to keep the order stable.
const sortedExperiences = experiences.sort((a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) => {
  if (a.data.current !== b.data.current) return a.data.current ? -1 : 1;
  const byStart = b.data.startDate.getTime() - a.data.startDate.getTime();
  if (byStart !== 0) return byStart;
  return (b.data.endDate?.getTime() ?? 0) - (a.data.endDate?.getTime() ?? 0);
});

// Splits "Mobile Engineer at 9Lives" into role + company for the timeline.
const splitRole = (title: string) => {
  const at = title.lastIndexOf(" at ");
  if (at === -1) return { role: title, company: "" };
  return { role: title.slice(0, at), company: title.slice(at + 4) };
};

const projects = await getCollection("projects");
// Newest first so the two most recent shipped apps lead the grid.
const projectOrder = ["mecfur", "swiftpay", "clinsign-mobile-app", "project-name", "ai-image-editor", "ambufur", "flowna", "mykudi"];
const featuredProjects = projects
  .filter((project: CollectionEntry<"projects">) => project.data.featured)
  .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => {
    const ia = projectOrder.indexOf(a.id);
    const ib = projectOrder.indexOf(b.id);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  })
  .slice(0, 8);

// Years of experience, from the earliest role start to today. Rounded down so
// the number is never inflated.
const firstStart = Math.min(...experiences.map((e: CollectionEntry<"experience">) => e.data.startDate.getTime()));
const years = Math.floor((Date.now() - firstStart) / (1000 * 60 * 60 * 24 * 365.25));
const stats = [{ value: years, suffix: "+", label: "Years shipping" }, ...(site.stats ?? [])];

// Headline: the phrase wrapped in *asterisks* becomes the italic serif accent.
// Everything is split into words so each can animate in on its own.
const headline = site.headline ?? site.title;
const headlineParts = headline.split(/\*(.+?)\*/).flatMap((chunk, i) =>
  chunk
    .split(/\s+/)
    .filter(Boolean)
    .map((word) => ({ word, accent: i % 2 === 1 })),
);

// Everything in the toolkit, flattened for the marquee.
const marqueeItems = (site.skills ?? []).flatMap((group) => group.items);

const currentRole = sortedExperiences.find((e: CollectionEntry<"experience">) => e.data.current);
const socialIcons: Record<string, string> = {
  GitHub:
    "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3",
  Twitter: "M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9zm-1.3 19.4h2L6.5 3.2H4.3z",
};

// Hero portrait is the live GitHub avatar, so it follows the profile picture.
const githubUrl = site.socialLinks?.find((l) => l.platform === "GitHub")?.url;
const githubUser = githubUrl ? new URL(githubUrl).pathname.split("/").filter(Boolean)[0] : undefined;
const portraitSrc = githubUser ? `https://github.com/${githubUser}.png?size=640` : "/me.png";

// Home-page structured data: the site itself, and this page as a profile.
const origin = Astro.site?.href ?? "/";
const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.seoName ?? site.name,
    url: origin,
    description: site.introduction,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: origin,
    mainEntity: {
      "@type": "Person",
      name: site.seoName ?? site.name,
      jobTitle: site.title,
      url: origin,
      sameAs: site.socialLinks?.map((l) => l.url),
      knowsAbout: (site.skills ?? []).flatMap((g) => g.items),
    },
  },
];

let sectionIndex = 0;
---

<BaseLayout title="Nathaniel Joseph | Mobile & Full-stack Engineer" description={site.introduction} wide schema={homeSchema}>
  <div class="cursor-glow" aria-hidden="true"></div>

  <!-- Section dock: scroll-spy rail on wide screens. -->
  <nav class="dock" aria-label="Sections" data-dock>
    {
      [
        ["top", "Intro"],
        ["services", "What I do"],
        ["work", "Work"],
        ["experience", "Experience"],
        ["reviews", "Reviews"],
        ["principles", "How I work"],
        ["skills", "Toolkit"],
        ["writing", "Writing"],
        ["faq", "FAQ"],
        ["contact", "Contact"],
      ].map(([id, label]) => (
        <a href={`#${id}`} class="dock-link" data-dock-link={id}>
          <span class="dock-dot" aria-hidden="true" />
          <span class="dock-label">{label}</span>
        </a>
      ))
    }
  </nav>

  <Container>
    <!-- Styles scope to this element; the Container itself does not receive the
         page's scoped attribute, so the class has to live on a local element. -->
    <div class="landing">
    <!-- ───────────────────────── Hero ───────────────────────── -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>
          {
            site.availability && (
              <span class="status">
                <span class="status-dot" aria-hidden="true" />
                <span class="status-text">{site.availability}</span>
              </span>
            )
          }
          {site.contact?.location && <span class="eyebrow-sep">·</span>}
          {site.contact?.location && <span>{site.contact.location}</span>}
        </p>

        <h1 class="headline" aria-label={headline.replace(/\*/g, "")}>
          {
            headlineParts.map(({ word, accent }, i) => (
              <span class="word-clip" aria-hidden="true">
                <span class:list={["word", { accent }]} style={`--i: ${i}`}>
                  {word}
                </span>
              </span>
            ))
          }
        </h1>

        <p class="role-line" data-reveal style={revealDelay(2)}>
          <span class="role-name">{site.name}</span>
          <span class="role-sep">—</span>
          <span>{site.title}</span>
        </p>

        <p class="lede" data-reveal style={revealDelay(3)}>{site.introduction}</p>

        <div class="hero-actions" data-reveal style={revealDelay(4)}>
          {
            site.contact && (
              <a class="btn btn-primary" href={`mailto:${site.contact.email}`} data-magnetic>
                <span>Start a conversation</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            )
          }
          <a class="btn btn-ghost" href={resumeUrl} download="Nathaniel Joseph - Frontend Developer CV.docx" data-magnetic>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            <span>Download résumé</span>
          </a>
        </div>

        {
          site.socialLinks && (
            <div class="social-links" data-reveal style={revealDelay(5)}>
              <span class="social-label">Find me on</span>
              {site.socialLinks.map(({ platform, url }) => (
                <a href={url} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={platform}>
                  {socialIcons[platform] ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={socialIcons[platform]} />
                    </svg>
                  ) : (
                    platform
                  )}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="hero-visual" data-reveal="scale" style={revealDelay(2)}>
        <div class="portrait-frame" data-tilt>
          <div class="portrait glass">
            <img src={portraitSrc} alt={`Portrait of ${site.name}`} width="640" height="640" loading="eager" fetchpriority="high" />
            <div class="portrait-shine" aria-hidden="true"></div>
          </div>
        </div>

        {
          currentRole && (
            <div class="float-badge badge-now glass" style="--float-rot: -2deg">
              <span class="badge-label">Now</span>
              <span class="badge-value">{splitRole(currentRole.data.title).company || currentRole.data.title}</span>
            </div>
          )
        }
        <div class="float-badge badge-stack glass" style="--float-rot: 2deg">
          <span class="badge-label">Stack</span>
          <span class="badge-value">React Native · Nest.js</span>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Stats ───────────────────────── -->
    <div class="stats glass" data-reveal>
      {
        stats.map((stat, i) => (
          <div class="stat" style={revealDelay(i, 120)}>
            <span class="stat-value">
              <span class="count" data-count={stat.value}>
                {stat.value.toLocaleString("en-US")}
              </span>
              {stat.suffix && <span class="stat-suffix">{stat.suffix}</span>}
            </span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <!-- ───────────────────────── Marquee ───────────────────────── -->
    {
      marqueeItems.length > 0 && (
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {[...marqueeItems, ...marqueeItems].map((item) => (
              <span class="marquee-item">
                <span class="marquee-dot" />
                {item}
              </span>
            ))}
          </div>
        </div>
      )
    }

    <!-- ───────────────────────── Services ───────────────────────── -->
    {
      site.services && site.sections.services && (
        <Section class="landing-section" id="services">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.services.title}</span>
            <h2>
              Product engineering, <em>end to end</em>
            </h2>
          </header>
          <div class="services">
            {site.services.map((service, i) => (
              <article class="service glass" data-reveal data-spotlight style={revealDelay(i, 110)}>
                <div class="service-icon" aria-hidden="true">
                  {i === 0 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="7" y="2" width="10" height="20" rx="2.5" />
                      <path d="M11 18h2" />
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="7" rx="2" />
                      <rect x="3" y="13" width="18" height="7" rx="2" />
                      <path d="M7 7.5h.01M7 16.5h.01" />
                    </svg>
                  )}
                  {i >= 2 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2.5" />
                      <path d="M3 9h18M9 21V9" />
                    </svg>
                  )}
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                {service.tags && (
                  <div class="tags">
                    {service.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Projects ───────────────────────── -->
    <!-- Pinned: the section is tall, the viewport inside it sticks, and scroll
         progress through the section drives the track sideways. -->
    <section class="landing-section showcase-section" id="work" data-showcase style={`--n: ${featuredProjects.length}`}>
      <div class="showcase-sticky">
        <span class="showcase-progress" aria-hidden="true"><i data-showcase-bar /></span>
        <header class="section-head showcase-head">
          <div>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.projects.title}</span>
            <h2>Shipped, <em>not just built</em></h2>
          </div>
          <div class="showcase-nav">
            <span class="showcase-hint">Keep scrolling</span>
            <button type="button" class="showcase-btn" data-showcase-prev aria-label="Previous project">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6" /></svg>
            </button>
            <div class="showcase-dots" data-showcase-dots role="tablist" aria-label="Choose project">
              {featuredProjects.map((project, i) => (
                <button type="button" class:list={["showcase-dot", { "is-active": i === 0 }]} data-showcase-dot={i} role="tab" aria-label={project.data.name ?? project.data.title} />
              ))}
            </div>
            <button type="button" class="showcase-btn" data-showcase-next aria-label="Next project">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6" /></svg>
            </button>
          </div>
        </header>

        <div class="showcase-track" data-showcase-track>
          {
            featuredProjects.map((project, i) => {
              const stores = project.data.stores ?? [];
              const shots = project.data.screenshots ?? [];
              return (
                <article class="slide" data-slide style={`--slide-accent: ${project.data.accent ?? "var(--accent)"}`}>
                  <div class="slide-inner">
                    <div class="slide-copy">
                      <div class="slide-top">
                        <span class="slide-index">{pad(i + 1)}</span>
                        <span class="slide-rule" aria-hidden="true" />
                        {project.data.name && <span class="slide-name">{project.data.name}</span>}
                        {project.data.status === "in-progress" && (
                          <span class="slide-status">
                            <i aria-hidden="true" />
                            In progress
                          </span>
                        )}
                      </div>
                      <h3>{project.data.title}</h3>
                      <p class="slide-desc">{project.data.description}</p>

                      <dl class="spec">
                        {project.data.role && (
                          <div class="spec-row">
                            <dt>Role</dt>
                            <dd>{project.data.role}</dd>
                          </div>
                        )}
                        {project.data.highlight && (
                          <div class="spec-row">
                            <dt>Outcome</dt>
                            <dd>{project.data.highlight}</dd>
                          </div>
                        )}
                        {project.data.techs && (
                          <div class="spec-row">
                            <dt>Stack</dt>
                            <dd>{project.data.techs.join(" · ")}</dd>
                          </div>
                        )}
                        {stores.length > 0 && (
                          <div class="spec-row">
                            <dt>Live on</dt>
                            <dd class="stores">
                              {stores.includes("ios") && (
                                <span class="store">
                                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8 2.2-1.2 3-2.4c.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-3.8M14 5.4c.7-.8 1.1-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4" /></svg>
                                  App Store
                                </span>
                              )}
                              {stores.includes("android") && (
                                <span class="store">
                                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.2 13.9 12 3.6 21.8c-.4-.2-.6-.6-.6-1.1V3.3c0-.5.2-.9.6-1.1m12.1 8L5.3 3.5l8.9 5.1zm4.5 1.8-2.9 1.7-2.6-2.5 2.6-2.5 3 1.7c.8.5.8 1.2-.1 1.6M5.3 20.5l10.4-6.7-1.8-1.8z" /></svg>
                                  Google Play
                                </span>
                              )}
                              {stores.includes("web") && (
                                <span class="store">
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
                                  Web
                                </span>
                              )}
                            </dd>
                          </div>
                        )}
                      </dl>

                      <div class="slide-foot">
                        {project.data.url ? (
                          <a class="btn btn-primary" href={project.data.url} target="_blank" rel="noopener noreferrer" data-magnetic>
                            <span>Visit project</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                          </a>
                        ) : (
                          <span class="btn btn-ghost slide-soon">Coming soon</span>
                        )}
                        <span class="slide-count">{pad(i + 1)} / {pad(featuredProjects.length)}</span>
                      </div>
                    </div>

                    <div class="stage">
                      <span class="stage-num" aria-hidden="true">{pad(i + 1)}</span>
                      <span class="stage-corner tl" aria-hidden="true" /><span class="stage-corner tr" aria-hidden="true" />
                      <span class="stage-corner bl" aria-hidden="true" /><span class="stage-corner br" aria-hidden="true" />
                      <div class="stage-device">
                        <PhoneMock variant={project.data.mock} accent={project.data.accent} name={project.data.name} screenshot={shots[0]} statusBar={project.data.statusBar} class="slide-phone" />
                      </div>
                      <span class="stage-label">
                        {project.data.status === "in-progress" ? "Work in progress" : shots[0] ? "Production build" : "Illustrated preview"}
                      </span>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

      </div>
    </section>

    <!-- ───────────────────────── Experience ───────────────────────── -->
    <Section class="landing-section" id="experience">
      <header class="section-head section-head-row" data-reveal>
        <div>
          <span class="kicker">{pad(++sectionIndex)} — {site.sections.experience.title}</span>
          <h2>{sortedExperiences.length} teams, <em>one throughline</em></h2>
        </div>
        <a class="text-link" href={resumeUrl} download="Nathaniel Joseph - Frontend Developer CV.docx">
          {site.sections.experience.viewAllText}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </header>

      <ol class="timeline">
        {
          sortedExperiences.map((exp, i) => {
            const { role, company } = splitRole(exp.data.title);
            return (
              <li class="timeline-item" data-reveal="left" style={revealDelay(i, 90)}>
                <div class="timeline-when">
                  <time datetime={exp.data.startDate.toISOString()}>{formatMonthYear(exp.data.startDate)}</time>
                  <span class="timeline-to">→</span>
                  <time>{exp.data.current ? "Present" : formatMonthYear(exp.data.endDate)}</time>
                </div>
                <div class:list={["timeline-dot", { current: exp.data.current }]} aria-hidden="true" />
                <article class="timeline-card glass" data-spotlight>
                  <div class="timeline-title">
                    <h3>{role}</h3>
                    {company && <span class="timeline-company">{company}</span>}
                    {exp.data.current && <span class="pill-now">Current</span>}
                  </div>
                  <p>{exp.data.description}</p>
                </article>
              </li>
            );
          })
        }
      </ol>
    </Section>

    <!-- ───────────────────────── Reviews ───────────────────────── -->
    {
      site.reviews && site.reviews.length > 0 && site.sections.reviews && (
        <Section class="landing-section" id="reviews">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.reviews.title}</span>
            <h2>
              In their <em>words</em>
            </h2>
          </header>
          <div class="reviews">
            {site.reviews.map((review, i) => (
              <figure class="review glass" data-reveal data-spotlight style={revealDelay(i, 100)}>
                <span class="review-mark" aria-hidden="true">“</span>
                <blockquote>
                  <p>{review.quote}</p>
                </blockquote>
                <figcaption>
                  <span class="review-who">
                    <span class="review-name">{review.name}</span>
                    <span class="review-role">
                      {review.role}
                      {review.company && (
                        <>
                          {" · "}
                          {review.url ? (
                            <a href={review.url} target="_blank" rel="noopener noreferrer">
                              {review.company}
                            </a>
                          ) : (
                            review.company
                          )}
                        </>
                      )}
                    </span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Principles ───────────────────────── -->
    {
      site.principles && site.sections.principles && (
        <Section class="landing-section" id="principles">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.principles.title}</span>
            <h2>
              Opinions, <em>earned the hard way</em>
            </h2>
          </header>
          <div class="principles">
            {site.principles.map((principle, i) => (
              <article class="principle" data-reveal="blur" style={revealDelay(i, 100)}>
                <span class="principle-index">{pad(i + 1)}</span>
                <div>
                  <h3>{principle.title}</h3>
                  <p>{principle.description}</p>
                </div>
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Skills ───────────────────────── -->
    {
      site.skills && site.sections.skills && (
        <Section class="landing-section" id="skills">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.skills.title}</span>
            <h2>
              The toolkit, <em>kept sharp</em>
            </h2>
          </header>
          <div class="skill-groups glass">
            {site.skills.map((group, i) => (
              <div class="skill-group" data-reveal style={revealDelay(i, 70)}>
                <span class="skill-category">{group.category}</span>
                <div class="skill-items">
                  {group.items.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Writing ───────────────────────── -->
    <Section class="landing-section" id="writing">
      <header class="section-head section-head-row" data-reveal>
        <div>
          <span class="kicker">{pad(++sectionIndex)} — {site.sections.blog.title}</span>
          <h2>Notes from <em>the field</em></h2>
        </div>
        <a class="text-link" href="/blog">
          {site.sections.blog.viewAllText}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </header>
      <div class="posts">
        {
          latestPosts.map((post, i) => (
            <a class="post" href={`/blog/${post.id}`} data-reveal style={revealDelay(i, 90)}>
              <div class="post-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <div class="post-meta">
                {post.data.publishedAt && (
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                )}
                <span class="post-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </Section>

    <!-- ───────────────────────── FAQ ───────────────────────── -->
    {
      site.faq && site.sections.faq && (
        <Section class="landing-section" id="faq">
          <div class="faq-grid">
            <header class="section-head faq-head" data-reveal>
              <span class="kicker">{pad(++sectionIndex)} — {site.sections.faq.title}</span>
              <h2>
                Questions, <em>answered upfront</em>
              </h2>
              <p class="faq-lede">The things people usually ask in a first call — so we can skip to the interesting part.</p>
            </header>
            <div class="faq" data-faq>
              {site.faq.map((item, i) => (
                <details class="faq-item glass" data-reveal style={revealDelay(i, 80)} open={i === 0}>
                  <summary class="faq-q">
                    <span class="faq-index">{pad(i + 1)}</span>
                    <span class="faq-question">{item.q}</span>
                    <span class="faq-chevron" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-a">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Contact ───────────────────────── -->
    {
      site.contact && site.sections.contact && (
        <Section class="landing-section" id="contact">
          <div class="contact glass" data-reveal="scale" data-contact data-spotlight>
            <div class="contact-glow" aria-hidden="true" />

            <div class="contact-intro">
              <span class="kicker">{pad(++sectionIndex)} — {site.sections.contact.title}</span>
              <h2>
                Let's build something <em>that holds up.</em>
              </h2>
              <p class="contact-desc">{site.sections.contact.description}</p>

              <div class="contact-email">
                <a class="contact-email-link" href={`mailto:${site.contact.email}`}>
                  <span class="contact-email-at" aria-hidden="true">@</span>
                  <span class="contact-email-text">{site.contact.email}</span>
                </a>
                <button class="contact-copy" type="button" data-contact-copy={site.contact.email} aria-label="Copy email address">
                  <svg class="contact-copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a1 1 0 0 1 1-1h9" />
                  </svg>
                  <svg class="contact-copy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                  <span class="contact-copy-label">Copy</span>
                </button>
              </div>

              <ul class="contact-meta">
                {site.availability && (
                  <li>
                    <span class="contact-meta-dot" aria-hidden="true" />
                    {site.availability}
                  </li>
                )}
                <li>Usually replies within a day</li>
                {site.contact.location && <li>{site.contact.location}</li>}
              </ul>

              {site.socialLinks && (
                <div class="contact-socials">
                  {site.socialLinks.map(({ platform, url }) => (
                    <a class="contact-social" href={url} target="_blank" rel="noopener noreferrer">
                      {socialIcons[platform] && (
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d={socialIcons[platform]} />
                        </svg>
                      )}
                      <span>{platform}</span>
                      <svg class="contact-social-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </a>
                  ))}
                </div>
              )}
            </div>

            <!-- Composer: builds a mailto: link, so it works with no backend. -->
            <form class="composer" data-composer data-email={site.contact.email} novalidate>
              <div class="composer-head">
                <span class="composer-title">Write me a note</span>
                <span class="composer-hint" data-composer-hint>Lands in my inbox</span>
              </div>

              <fieldset class="composer-topics">
                <legend class="composer-label">What's it about?</legend>
                {["A mobile app", "A backend", "A full-time role", "Contract work", "Something else"].map((topic, i) => (
                  <label class="topic">
                    <input type="radio" name="topic" value={topic} checked={i === 0} />
                    <span>{topic}</span>
                  </label>
                ))}
              </fieldset>

              <label class="composer-field composer-subject" data-composer-subject hidden>
                <span class="composer-label">What should the subject be? <em class="req" title="Required">*</em></span>
                <input type="text" name="subject" placeholder="e.g. Speaking at our meetup" maxlength="80" autocomplete="off" />
              </label>

              <div class="composer-grid">
                <label class="composer-field">
                  <span class="composer-label">Your name</span>
                  <input type="text" name="name" placeholder="Ada Lovelace" autocomplete="name" />
                </label>
                <label class="composer-field">
                  <span class="composer-label">Your email <em class="req" title="Required">*</em></span>
                  <input type="email" name="email" placeholder="ada@example.com" autocomplete="email" required />
                </label>
              </div>
              <!-- Honeypot: hidden from people, filled by bots. -->
              <label class="composer-trap" aria-hidden="true">
                <span>Leave this empty</span>
                <input type="text" name="_hp_leave_empty" tabindex="-1" autocomplete="off" data-lpignore="true" data-1p-ignore />
              </label>

              <label class="composer-field">
                <span class="composer-label">Message <em class="req" title="Required">*</em></span>
                <textarea name="message" rows="4" placeholder="A couple of lines is plenty — what are you building, and where are you stuck?" maxlength="1200" />
              </label>

              <div class="composer-foot">
                <span class="composer-count" data-composer-count>0 / 1200</span>
                <button class="btn btn-primary" type="submit" data-magnetic data-composer-submit>
                  <span data-composer-submit-label>Send message</span>
                  <svg class="composer-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                  <svg class="composer-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 3a9 9 0 1 0 9 9" />
                  </svg>
                </button>
              </div>

            </form>
          </div>
        </Section>
      )
    }

    <footer class="footer" data-reveal>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span class="footer-sep">·</span>
      <span>Built with Astro, hosted on Vercel</span>
      <a class="back-top" href="#top">
        Back to top
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5m0 0-6 6m6-6 6 6" />
        </svg>
      </a>
    </footer>
    </div>
  </Container>
</BaseLayout>

<script>
  import emailjs from "@emailjs/browser";

  // EmailJS runs in the browser; these PUBLIC_ values are inlined at build time.
  const EMAILJS = {
    publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY as string | undefined,
    serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID as string | undefined,
    templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID as string | undefined,
  };
  const emailjsReady = Boolean(EMAILJS.publicKey && EMAILJS.serviceId && EMAILJS.templateId);
  if (emailjsReady) emailjs.init({ publicKey: EMAILJS.publicKey! });

  // Page-level interactions. Everything here is decorative: the page reads and
  // navigates fine if any of it never runs.

  const fine = () => window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Tilt — the portrait leans toward the pointer, and relaxes back on leave.
  const initTilt = () => {
    if (!fine() || reduced()) return;
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      const max = 9;
      el.addEventListener("pointermove", (e) => {
        const rect = el.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        el.style.setProperty("--rx", `${(-py * max).toFixed(2)}deg`);
        el.style.setProperty("--ry", `${(px * max).toFixed(2)}deg`);
        el.style.setProperty("--sx", `${(px * 100 + 50).toFixed(1)}%`);
        el.style.setProperty("--sy", `${(py * 100 + 50).toFixed(1)}%`);
      });
      el.addEventListener("pointerleave", () => {
        el.style.setProperty("--rx", "0deg");
        el.style.setProperty("--ry", "0deg");
      });
    });
  };

  // Count-up — stat figures tick from 0 to their value the first time they
  // scroll into view. Reduced motion skips straight to the final number.
  const initCounters = () => {
    const counters = document.querySelectorAll<HTMLElement>("[data-count]");
    if (!counters.length) return;

    const format = (n: number) => Math.round(n).toLocaleString("en-US");
    // The final value is server-rendered so the figure is correct without JS;
    // the count only rewinds to 0 here, at the moment it starts animating.
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count ?? 0);
      if (reduced() || !Number.isFinite(target)) {
        el.textContent = format(target);
        return;
      }
      el.textContent = "0";
      const duration = 1400;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 4);
        el.textContent = format(target * eased);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (!("IntersectionObserver" in window)) {
      counters.forEach(run);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          run(entry.target as HTMLElement);
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    counters.forEach((el) => io.observe(el));
  };

  // Cursor glow — a large soft light that trails the pointer across the page.
  // Lerped in rAF so it feels weighty rather than glued to the cursor.
  let glowRaf = 0;
  const initCursorGlow = () => {
    const glow = document.querySelector<HTMLElement>(".cursor-glow");
    if (!glow || !fine() || reduced()) return;

    let tx = window.innerWidth / 2;
    let ty = window.innerHeight / 3;
    let x = tx;
    let y = ty;

    window.addEventListener(
      "pointermove",
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        glow.classList.add("is-active");
      },
      { passive: true },
    );

    const loop = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      glow.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      glowRaf = requestAnimationFrame(loop);
    };
    cancelAnimationFrame(glowRaf);
    loop();
  };

  // Section dock — highlights whichever section is closest to the top of the viewport.
  const initDock = () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-dock-link]")];
    if (!links.length || !("IntersectionObserver" in window)) return;
    const targets = links.map((l) => document.getElementById(l.dataset.dockLink!)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => links.forEach((l) => l.classList.toggle("is-active", l.dataset.dockLink === id));
    const io = new IntersectionObserver(
      (entries) => {
        // Prefer the entry nearest the top among those intersecting.
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-35% 0px -55% 0px", threshold: 0 },
    );
    targets.forEach((t) => io.observe(t));
    links.forEach((l) =>
      l.addEventListener("click", (e) => {
        e.preventDefault();
        const target = document.getElementById(l.dataset.dockLink!);
        if (!target) return;
        if (window.__portfolioLenis) window.__portfolioLenis.scrollTo(target, { offset: -88 });
        else target.scrollIntoView({ behavior: reduced() ? "auto" : "smooth" });
        history.replaceState(null, "", `#${l.dataset.dockLink}`);
      }),
    );
  };

  // FAQ accordion — <details> does the work; this only animates the height
  // and keeps a single item open at a time.
  const initFaq = () => {
    const items = [...document.querySelectorAll<HTMLDetailsElement>("[data-faq] details")];
    items.forEach((el) => {
      const summary = el.querySelector<HTMLElement>("summary")!;
      const body = el.querySelector<HTMLElement>(".faq-a")!;
      summary.addEventListener("click", (e) => {
        e.preventDefault();
        if (reduced()) {
          el.open = !el.open;
          items.forEach((o) => o !== el && (o.open = false));
          return;
        }
        if (el.open) {
          const h = body.offsetHeight;
          body.animate([{ height: `${h}px`, opacity: 1 }, { height: "0px", opacity: 0 }], { duration: 260, easing: "ease" }).onfinish = () => {
            el.open = false;
          };
          return;
        }
        items.forEach((o) => o !== el && o.open && o.querySelector<HTMLElement>("summary")!.click());
        el.open = true;
        const h = body.offsetHeight;
        body.animate([{ height: "0px", opacity: 0 }, { height: `${h}px`, opacity: 1 }], { duration: 320, easing: "cubic-bezier(0.16, 1, 0.3, 1)" });
      });
    });
  };

  // Contact card: inline copy button with a morph to a check mark, and a
  // composer that hands the note to the visitor's mail app via mailto:.
  const initContact = () => {
    const copy = document.querySelector<HTMLButtonElement>("[data-contact-copy]");
    let copyTimer = 0;
    copy?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.contactCopy ?? "");
        copy.classList.add("is-copied");
        window.clearTimeout(copyTimer);
        copyTimer = window.setTimeout(() => copy.classList.remove("is-copied"), 1800);
      } catch {
        window.dispatchEvent(new CustomEvent("toast", { detail: { message: "Couldn't copy — select it instead", type: "error" } }));
      }
    });

    const form = document.querySelector<HTMLFormElement>("[data-composer]");
    if (!form) return;
    const textarea = form.querySelector<HTMLTextAreaElement>("textarea")!;
    const count = form.querySelector<HTMLElement>("[data-composer-count]")!;
    const max = Number(textarea.maxLength) || 1200;

    // Grow with the text instead of scrolling inside a small box.
    const autosize = () => {
      textarea.style.height = "auto";
      textarea.style.height = `${textarea.scrollHeight}px`;
    };
    const updateCount = () => {
      const n = textarea.value.length;
      count.textContent = `${n} / ${max}`;
      count.classList.toggle("is-near", n > max * 0.9);
    };
    textarea.addEventListener("input", () => {
      autosize();
      updateCount();
    });
    autosize();
    updateCount();

    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const subjectWrap = form.querySelector<HTMLElement>("[data-composer-subject]")!;
    const subjectInput = subjectWrap.querySelector<HTMLInputElement>("input")!;
    const OTHER = "Something else";

    // "Something else" reveals a free-text subject; picking any other chip hides it again.
    const syncSubject = (focus = false) => {
      const picked = form.querySelector<HTMLInputElement>('input[name="topic"]:checked')?.value;
      const other = picked === OTHER;
      subjectWrap.hidden = !other;
      if (other && focus) subjectInput.focus();
    };
    form.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) =>
      r.addEventListener("change", () => syncSubject(true)),
    );
    syncSubject();
    const submit = form.querySelector<HTMLButtonElement>("[data-composer-submit]")!;
    const submitLabel = form.querySelector<HTMLElement>("[data-composer-submit-label]")!;

    // Validation failures shake the form and say why, so a non-send is never silent.
    const shake = (focus?: HTMLElement, why?: string) => {
      focus?.focus();
      focus?.classList.add("is-invalid");
      focus?.addEventListener("input", () => focus.classList.remove("is-invalid"), { once: true });
      form.classList.add("is-shaking");
      setTimeout(() => form.classList.remove("is-shaking"), 400);
      if (why) window.dispatchEvent(new CustomEvent("toast", { detail: { message: why, type: "error" } }));
    };

    setTimeout(() => {
      form.classList.remove("is-sending");
      submit.disabled = false;
    });

    const setSending = (on: boolean) => {
      form.classList.toggle("is-sending", on);
      submit.disabled = on;
      submitLabel.textContent = on ? "Sending…" : "Send message";
    };

    // Last resort when the server can't send: hand the note to their mail app.
    const mailtoFallback = (topic: string, name: string, message: string) => {
      const subject = `${topic}${name ? ` — from ${name}` : ""}`;
      const body = `${message}\n\n${name ? `— ${name}` : ""}`.trim();
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.dispatchEvent(new CustomEvent("toast", { detail: { message: "Opening your mail app instead…", type: "info" } }));
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const picked = String(data.get("topic") ?? "");
      const custom = String(data.get("subject") ?? "").trim();
      const topic = picked === OTHER ? custom : picked;
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();
      const website = String(data.get("_hp_leave_empty") ?? "");

      if (picked === OTHER && !custom) return shake(subjectInput, "Add a subject so I know what it's about");
      if (!message) return shake(textarea, "Write a message first");
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return shake(emailInput, "Add a valid email so I can reply");

      // Bots fill the hidden field; people can't. Pretend it worked and drop it.
      if (website) {
        form.reset();
        window.dispatchEvent(new CustomEvent("toast", { detail: { message: "Message sent", type: "success" } }));
        return;
      }

      if (!emailjsReady) {
        mailtoFallback(topic, name, message);
        return;
      }

      setSending(true);
      try {
        const sender = name || "Someone from the portfolio";
        // Never let a hung request leave the button disabled forever.
        const timeout = new Promise<never>((_, reject) => setTimeout(() => reject(new Error("timeout")), 15_000));
        await Promise.race([timeout, emailjs.send(EMAILJS.serviceId!, EMAILJS.templateId!, {
          // Names used by the EmailJS "Contact Us" template…
          title: topic,
          name: sender,
          email,
          time: new Date().toLocaleString("en-GB", { dateStyle: "medium", timeStyle: "short" }),
          message,
          // …and the older aliases, so a custom template can use either.
          from_name: sender,
          reply_to: email,
          topic,
        })]);
        form.reset();
        autosize();
        updateCount();
        syncSubject();
        window.dispatchEvent(new CustomEvent("toast", { detail: { message: "Message sent — I'll reply within a day", type: "success" } }));
      } catch (err) {
        console.error("[contact] emailjs", err);
        const timedOut = err instanceof Error && err.message === "timeout";
        window.dispatchEvent(
          new CustomEvent("toast", {
            detail: {
              message: timedOut ? "That took too long — check your connection and try again" : "Couldn't send — please try again or email me directly",
              type: "error",
            },
          }),
        );
      } finally {
        setSending(false);
      }
    });

  };

  // Project showcase — pinned section. Vertical scroll through the tall
  // section is mapped onto the track's horizontal position, so the visitor
  // scrolls sideways through the projects and then carries on down the page.
  // Below 960px the section is a plain vertical stack and this does nothing.
  const initShowcase = () => {
    const root = document.querySelector<HTMLElement>("[data-showcase]");
    const track = root?.querySelector<HTMLElement>("[data-showcase-track]");
    if (!root || !track) return;
    const slides = [...track.querySelectorAll<HTMLElement>("[data-slide]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-showcase-dot]")];
    const bar = root.querySelector<HTMLElement>("[data-showcase-bar]");
    const pinned = () => window.matchMedia("(min-width: 961px)").matches;
    const n = slides.length;
    let active = -1;
    let raf = 0;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      slides.forEach((el, j) => el.classList.toggle("is-active", j === i));
      dots.forEach((d, j) => {
        d.classList.toggle("is-active", j === i);
        d.setAttribute("aria-selected", String(j === i));
      });
    };

    // 0 → 1 as the section's pinned range scrolls past.
    const progress = () => {
      const rect = root.getBoundingClientRect();
      const range = root.offsetHeight - window.innerHeight;
      return range <= 0 ? 0 : Math.min(1, Math.max(0, -rect.top / range));
    };

    const update = () => {
      raf = 0;
      if (!pinned()) {
        track.style.transform = "";
        slides.forEach((el) => el.classList.add("is-active"));
        return;
      }
      const p = progress();
      const w = slides[0]?.offsetWidth ?? window.innerWidth;
      track.style.transform = `translate3d(${(-p * (n - 1) * w).toFixed(1)}px, 0, 0)`;
      if (bar) bar.style.transform = `scaleX(${p})`;
      setActive(Math.round(p * (n - 1)));
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    const lenis = window.__portfolioLenis;
    if (lenis && typeof lenis.on === "function") lenis.on("scroll", onScroll);

    // Jump to a slide by scrolling the page to the matching point in the
    // section — through Lenis when it's running so the easing matches.
    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(n - 1, i));
      if (!pinned()) {
        slides[target]?.scrollIntoView({ behavior: reduced() ? "auto" : "smooth", block: "start" });
        return;
      }
      const top = root.getBoundingClientRect().top + window.scrollY;
      const y = top + (target / (n - 1)) * (root.offsetHeight - window.innerHeight);
      if (window.__portfolioLenis) window.__portfolioLenis.scrollTo(y, { duration: 1 });
      else window.scrollTo({ top: y, behavior: reduced() ? "auto" : "smooth" });
    };

    root.querySelector("[data-showcase-prev]")?.addEventListener("click", () => goTo(active - 1));
    root.querySelector("[data-showcase-next]")?.addEventListener("click", () => goTo(active + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));

    update();
  };

  // Each feature is independent; a failure in one must not stop the rest
  // (a broken showcase once left the contact form doing a native submit).
  document.addEventListener("astro:page-load", () => {
    for (const init of [initShowcase, initContact, initFaq, initTilt, initCounters, initCursorGlow, initDock]) {
      try {
        init();
      } catch (err) {
        console.error("[landing]", err);
      }
    }
  });
</script>

