# Local secrets for `astro dev` (git-ignored). Run `pnpm spotify:setup` — it fills this in.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: serve a fake "now playing" track locally to preview the widget.
# SPOTIFY_MOCK=1

# Contact form → email via EmailJS (https://www.emailjs.com). These are
# PUBLIC_ on purpose: EmailJS runs in the browser and the key is a public key.
# Lock it down in the EmailJS dashboard (allowed domains, reCAPTCHA if you like).
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
