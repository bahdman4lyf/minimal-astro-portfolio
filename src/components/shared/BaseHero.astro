---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="hero">
  <h1 data-reveal>{title}</h1>
  <p class="subtitle" data-reveal style="--reveal-delay: 70ms">{description}</p>
</section>

<style>
  .hero {
    padding: 4rem 0;
  }
</style>
