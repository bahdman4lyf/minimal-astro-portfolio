---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import ArticleLayout from "../../components/layout/ArticleLayout.astro";

export const getStaticPaths = (async () => {
  const posts = (await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );
  // Neighbours in date order: "next" is the newer post, "prev" the older one.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.publishedAt}
  kicker="Blog"
  backHref="/blog"
  backLabel="All posts"
  body={post.body}
  prev={older && { title: older.data.title, href: `/blog/${older.id}` }}
  next={newer && { title: newer.data.title, href: `/blog/${newer.id}` }}
>
  <Content />
</ArticleLayout>
