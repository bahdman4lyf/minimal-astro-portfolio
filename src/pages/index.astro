---
import Section from "../components/ui/Section.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
// `?url` makes Vite emit the file as a build asset and hand back its public path.
import resumeUrl from "../assets/docs/Nathaniel Joseph - Frontend- CV.docx?url";

const siteConfig = await getEntry("site", "home");
if (!siteConfig) {
  throw new Error("Site configuration not found");
}

const site = siteConfig.data;

const formatDate = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
};

const formatMonthYear = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

// Staggers a list so items cascade in rather than appearing all at once.
const revealDelay = (index: number, step = 80) => `--reveal-delay: ${index * step}ms`;

// Zero-padded section counter for the "01 — What I do" kickers.
const pad = (n: number) => String(n).padStart(2, "0");

const posts = await getCollection("blog", ({ data }: CollectionEntry<"blog">) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const latestPosts = posts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  )
  .slice(0, 3);

const experiences = await getCollection("experience");
// Current roles first, then most recently started. Several roles share a start
// month, so fall back to end date to keep the order stable.
const sortedExperiences = experiences.sort((a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) => {
  if (a.data.current !== b.data.current) return a.data.current ? -1 : 1;
  const byStart = b.data.startDate.getTime() - a.data.startDate.getTime();
  if (byStart !== 0) return byStart;
  return (b.data.endDate?.getTime() ?? 0) - (a.data.endDate?.getTime() ?? 0);
});

// Splits "Mobile Engineer at 9Lives" into role + company for the timeline.
const splitRole = (title: string) => {
  const at = title.lastIndexOf(" at ");
  if (at === -1) return { role: title, company: "" };
  return { role: title.slice(0, at), company: title.slice(at + 4) };
};

const projects = await getCollection("projects");
// Newest first so the two most recent shipped apps lead the grid.
const projectOrder = ["mecfur", "swiftpay", "clinsign-mobile-app", "project-name", "ai-image-editor"];
const featuredProjects = projects
  .filter((project: CollectionEntry<"projects">) => project.data.featured)
  .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => {
    const ia = projectOrder.indexOf(a.id);
    const ib = projectOrder.indexOf(b.id);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  })
  .slice(0, 5);

// Years of experience, from the earliest role start to today. Rounded down so
// the number is never inflated.
const firstStart = Math.min(...experiences.map((e: CollectionEntry<"experience">) => e.data.startDate.getTime()));
const years = Math.floor((Date.now() - firstStart) / (1000 * 60 * 60 * 24 * 365.25));
const stats = [{ value: years, suffix: "+", label: "Years shipping" }, ...(site.stats ?? [])];

// Headline: the phrase wrapped in *asterisks* becomes the italic serif accent.
// Everything is split into words so each can animate in on its own.
const headline = site.headline ?? site.title;
const headlineParts = headline.split(/\*(.+?)\*/).flatMap((chunk, i) =>
  chunk
    .split(/\s+/)
    .filter(Boolean)
    .map((word) => ({ word, accent: i % 2 === 1 })),
);

// Everything in the toolkit, flattened for the marquee.
const marqueeItems = (site.skills ?? []).flatMap((group) => group.items);

const currentRole = sortedExperiences.find((e: CollectionEntry<"experience">) => e.data.current);
const socialIcons: Record<string, string> = {
  GitHub:
    "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3",
  Twitter: "M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9zm-1.3 19.4h2L6.5 3.2H4.3z",
};

// Hero portrait is the live GitHub avatar, so it follows the profile picture.
const githubUrl = site.socialLinks?.find((l) => l.platform === "GitHub")?.url;
const githubUser = githubUrl ? new URL(githubUrl).pathname.split("/").filter(Boolean)[0] : undefined;
const portraitSrc = githubUser ? `https://github.com/${githubUser}.png?size=640` : "/me.png";

let sectionIndex = 0;
---

<BaseLayout title="Nathaniel Joseph | Mobile & Full-stack Engineer" description={site.introduction} wide>
  <div class="cursor-glow" aria-hidden="true"></div>

  <!-- Section dock: scroll-spy rail on wide screens. -->
  <nav class="dock" aria-label="Sections" data-dock>
    {
      [
        ["top", "Intro"],
        ["services", "What I do"],
        ["work", "Work"],
        ["experience", "Experience"],
        ["principles", "How I work"],
        ["skills", "Toolkit"],
        ["writing", "Writing"],
        ["faq", "FAQ"],
        ["contact", "Contact"],
      ].map(([id, label]) => (
        <a href={`#${id}`} class="dock-link" data-dock-link={id}>
          <span class="dock-dot" aria-hidden="true" />
          <span class="dock-label">{label}</span>
        </a>
      ))
    }
  </nav>

  <Container>
    <!-- Styles scope to this element; the Container itself does not receive the
         page's scoped attribute, so the class has to live on a local element. -->
    <div class="landing">
    <!-- ───────────────────────── Hero ───────────────────────── -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>
          {
            site.availability && (
              <span class="status">
                <span class="status-dot" aria-hidden="true" />
                <span class="status-text">{site.availability}</span>
              </span>
            )
          }
          {site.contact?.location && <span class="eyebrow-sep">·</span>}
          {site.contact?.location && <span>{site.contact.location}</span>}
        </p>

        <h1 class="headline" aria-label={headline.replace(/\*/g, "")}>
          {
            headlineParts.map(({ word, accent }, i) => (
              <span class="word-clip" aria-hidden="true">
                <span class:list={["word", { accent }]} style={`--i: ${i}`}>
                  {word}
                </span>
              </span>
            ))
          }
        </h1>

        <p class="role-line" data-reveal style={revealDelay(2)}>
          <span class="role-name">{site.name}</span>
          <span class="role-sep">—</span>
          <span>{site.title}</span>
        </p>

        <p class="lede" data-reveal style={revealDelay(3)}>{site.introduction}</p>

        <div class="hero-actions" data-reveal style={revealDelay(4)}>
          {
            site.contact && (
              <a class="btn btn-primary" href={`mailto:${site.contact.email}`} data-magnetic>
                <span>Start a conversation</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            )
          }
          <a class="btn btn-ghost" href={resumeUrl} download="Nathaniel Joseph - Frontend Developer CV.docx" data-magnetic>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            <span>Download résumé</span>
          </a>
        </div>

        {
          site.socialLinks && (
            <div class="social-links" data-reveal style={revealDelay(5)}>
              <span class="social-label">Find me on</span>
              {site.socialLinks.map(({ platform, url }) => (
                <a href={url} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={platform}>
                  {socialIcons[platform] ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={socialIcons[platform]} />
                    </svg>
                  ) : (
                    platform
                  )}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="hero-visual" data-reveal="scale" style={revealDelay(2)}>
        <div class="portrait-frame" data-tilt>
          <div class="portrait glass">
            <img src={portraitSrc} alt={`Portrait of ${site.name}`} width="640" height="640" loading="eager" fetchpriority="high" />
            <div class="portrait-shine" aria-hidden="true"></div>
          </div>
        </div>

        {
          currentRole && (
            <div class="float-badge badge-now glass" style="--float-rot: -2deg">
              <span class="badge-label">Now</span>
              <span class="badge-value">{splitRole(currentRole.data.title).company || currentRole.data.title}</span>
            </div>
          )
        }
        <div class="float-badge badge-stack glass" style="--float-rot: 2deg">
          <span class="badge-label">Stack</span>
          <span class="badge-value">React Native · Nest.js</span>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Stats ───────────────────────── -->
    <div class="stats glass" data-reveal>
      {
        stats.map((stat, i) => (
          <div class="stat" style={revealDelay(i, 120)}>
            <span class="stat-value">
              <span class="count" data-count={stat.value}>
                {stat.value.toLocaleString("en-US")}
              </span>
              {stat.suffix && <span class="stat-suffix">{stat.suffix}</span>}
            </span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <!-- ───────────────────────── Marquee ───────────────────────── -->
    {
      marqueeItems.length > 0 && (
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {[...marqueeItems, ...marqueeItems].map((item) => (
              <span class="marquee-item">
                <span class="marquee-dot" />
                {item}
              </span>
            ))}
          </div>
        </div>
      )
    }

    <!-- ───────────────────────── Services ───────────────────────── -->
    {
      site.services && site.sections.services && (
        <Section class="landing-section" id="services">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.services.title}</span>
            <h2>
              Product engineering, <em>end to end</em>
            </h2>
          </header>
          <div class="services">
            {site.services.map((service, i) => (
              <article class="service glass" data-reveal data-spotlight style={revealDelay(i, 110)}>
                <div class="service-icon" aria-hidden="true">
                  {i === 0 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="7" y="2" width="10" height="20" rx="2.5" />
                      <path d="M11 18h2" />
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="7" rx="2" />
                      <rect x="3" y="13" width="18" height="7" rx="2" />
                      <path d="M7 7.5h.01M7 16.5h.01" />
                    </svg>
                  )}
                  {i >= 2 && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2.5" />
                      <path d="M3 9h18M9 21V9" />
                    </svg>
                  )}
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                {service.tags && (
                  <div class="tags">
                    {service.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Projects ───────────────────────── -->
    <Section class="landing-section" id="work">
      <header class="section-head" data-reveal>
        <span class="kicker">{pad(++sectionIndex)} — {site.sections.projects.title}</span>
        <h2>Shipped, <em>not just built</em></h2>
      </header>
      <div class="projects">
        {
          featuredProjects.map((project, i) => (
            <a
              class="project glass"
              href={project.data.url}
              target="_blank"
              rel="noopener noreferrer"
              data-reveal
              data-spotlight
              style={revealDelay(i, 110)}
            >
              <div class="project-top">
                <span class="project-index">{pad(i + 1)}</span>
                <span class="project-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </span>
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              {project.data.techs && (
                <div class="tags">
                  {project.data.techs.map((tech) => (
                    <span class="tag">{tech}</span>
                  ))}
                </div>
              )}
            </a>
          ))
        }
      </div>
    </Section>

    <!-- ───────────────────────── Experience ───────────────────────── -->
    <Section class="landing-section" id="experience">
      <header class="section-head section-head-row" data-reveal>
        <div>
          <span class="kicker">{pad(++sectionIndex)} — {site.sections.experience.title}</span>
          <h2>{sortedExperiences.length} teams, <em>one throughline</em></h2>
        </div>
        <a class="text-link" href={resumeUrl} download="Nathaniel Joseph - Frontend Developer CV.docx">
          {site.sections.experience.viewAllText}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </header>

      <ol class="timeline">
        {
          sortedExperiences.map((exp, i) => {
            const { role, company } = splitRole(exp.data.title);
            return (
              <li class="timeline-item" data-reveal="left" style={revealDelay(i, 90)}>
                <div class="timeline-when">
                  <time datetime={exp.data.startDate.toISOString()}>{formatMonthYear(exp.data.startDate)}</time>
                  <span class="timeline-to">→</span>
                  <time>{exp.data.current ? "Present" : formatMonthYear(exp.data.endDate)}</time>
                </div>
                <div class:list={["timeline-dot", { current: exp.data.current }]} aria-hidden="true" />
                <article class="timeline-card glass" data-spotlight>
                  <div class="timeline-title">
                    <h3>{role}</h3>
                    {company && <span class="timeline-company">{company}</span>}
                    {exp.data.current && <span class="pill-now">Current</span>}
                  </div>
                  <p>{exp.data.description}</p>
                </article>
              </li>
            );
          })
        }
      </ol>
    </Section>

    <!-- ───────────────────────── Principles ───────────────────────── -->
    {
      site.principles && site.sections.principles && (
        <Section class="landing-section" id="principles">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.principles.title}</span>
            <h2>
              Opinions, <em>earned the hard way</em>
            </h2>
          </header>
          <div class="principles">
            {site.principles.map((principle, i) => (
              <article class="principle" data-reveal="blur" style={revealDelay(i, 100)}>
                <span class="principle-index">{pad(i + 1)}</span>
                <div>
                  <h3>{principle.title}</h3>
                  <p>{principle.description}</p>
                </div>
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Skills ───────────────────────── -->
    {
      site.skills && site.sections.skills && (
        <Section class="landing-section" id="skills">
          <header class="section-head" data-reveal>
            <span class="kicker">{pad(++sectionIndex)} — {site.sections.skills.title}</span>
            <h2>
              The toolkit, <em>kept sharp</em>
            </h2>
          </header>
          <div class="skill-groups glass">
            {site.skills.map((group, i) => (
              <div class="skill-group" data-reveal style={revealDelay(i, 70)}>
                <span class="skill-category">{group.category}</span>
                <div class="skill-items">
                  {group.items.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Writing ───────────────────────── -->
    <Section class="landing-section" id="writing">
      <header class="section-head section-head-row" data-reveal>
        <div>
          <span class="kicker">{pad(++sectionIndex)} — {site.sections.blog.title}</span>
          <h2>Notes from <em>the field</em></h2>
        </div>
        <a class="text-link" href="/blog">
          {site.sections.blog.viewAllText}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </header>
      <div class="posts">
        {
          latestPosts.map((post, i) => (
            <a class="post" href={`/blog/${post.id}`} data-reveal style={revealDelay(i, 90)}>
              <div class="post-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <div class="post-meta">
                {post.data.publishedAt && (
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                )}
                <span class="post-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </Section>

    <!-- ───────────────────────── FAQ ───────────────────────── -->
    {
      site.faq && site.sections.faq && (
        <Section class="landing-section" id="faq">
          <div class="faq-grid">
            <header class="section-head faq-head" data-reveal>
              <span class="kicker">{pad(++sectionIndex)} — {site.sections.faq.title}</span>
              <h2>
                Questions, <em>answered upfront</em>
              </h2>
              <p class="faq-lede">The things people usually ask in a first call — so we can skip to the interesting part.</p>
            </header>
            <div class="faq" data-faq>
              {site.faq.map((item, i) => (
                <details class="faq-item glass" data-reveal style={revealDelay(i, 80)} open={i === 0}>
                  <summary class="faq-q">
                    <span class="faq-index">{pad(i + 1)}</span>
                    <span class="faq-question">{item.q}</span>
                    <span class="faq-chevron" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-a">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </Section>
      )
    }

    <!-- ───────────────────────── Contact ───────────────────────── -->
    {
      site.contact && site.sections.contact && (
        <Section class="landing-section" id="contact">
          <div class="contact glass" data-reveal="scale" data-contact data-spotlight>
            <div class="contact-glow" aria-hidden="true" />

            <div class="contact-intro">
              <span class="kicker">{pad(++sectionIndex)} — {site.sections.contact.title}</span>
              <h2>
                Let's build something <em>that holds up.</em>
              </h2>
              <p class="contact-desc">{site.sections.contact.description}</p>

              <div class="contact-email">
                <a class="contact-email-link" href={`mailto:${site.contact.email}`}>
                  <span class="contact-email-at" aria-hidden="true">@</span>
                  <span class="contact-email-text">{site.contact.email}</span>
                </a>
                <button class="contact-copy" type="button" data-contact-copy={site.contact.email} aria-label="Copy email address">
                  <svg class="contact-copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a1 1 0 0 1 1-1h9" />
                  </svg>
                  <svg class="contact-copy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                  <span class="contact-copy-label">Copy</span>
                </button>
              </div>

              <ul class="contact-meta">
                {site.availability && (
                  <li>
                    <span class="contact-meta-dot" aria-hidden="true" />
                    {site.availability}
                  </li>
                )}
                <li>Usually replies within a day</li>
                {site.contact.location && <li>{site.contact.location}</li>}
              </ul>

              {site.socialLinks && (
                <div class="contact-socials">
                  {site.socialLinks.map(({ platform, url }) => (
                    <a class="contact-social" href={url} target="_blank" rel="noopener noreferrer">
                      {socialIcons[platform] && (
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d={socialIcons[platform]} />
                        </svg>
                      )}
                      <span>{platform}</span>
                      <svg class="contact-social-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </a>
                  ))}
                </div>
              )}
            </div>

            <!-- Composer: builds a mailto: link, so it works with no backend. -->
            <form class="composer" data-composer data-email={site.contact.email} novalidate>
              <div class="composer-head">
                <span class="composer-title">Write me a note</span>
                <span class="composer-hint">Opens in your mail app</span>
              </div>

              <fieldset class="composer-topics">
                <legend class="composer-label">What's it about?</legend>
                {["A mobile app", "A backend", "A full-time role", "Contract work", "Something else"].map((topic, i) => (
                  <label class="topic">
                    <input type="radio" name="topic" value={topic} checked={i === 0} />
                    <span>{topic}</span>
                  </label>
                ))}
              </fieldset>

              <label class="composer-field">
                <span class="composer-label">Your name</span>
                <input type="text" name="name" placeholder="Ada Lovelace" autocomplete="name" />
              </label>

              <label class="composer-field">
                <span class="composer-label">Message</span>
                <textarea name="message" rows="4" placeholder="A couple of lines is plenty — what are you building, and where are you stuck?" maxlength="1200" />
              </label>

              <div class="composer-foot">
                <span class="composer-count" data-composer-count>0 / 1200</span>
                <button class="btn btn-primary" type="submit" data-magnetic>
                  <span>Send email</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </Section>
      )
    }

    <footer class="footer" data-reveal>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span class="footer-sep">·</span>
      <span>Built with Astro, hosted on Vercel</span>
      <a class="back-top" href="#top">
        Back to top
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5m0 0-6 6m6-6 6 6" />
        </svg>
      </a>
    </footer>
    </div>
  </Container>
</BaseLayout>

<script>
  // Page-level interactions. Everything here is decorative: the page reads and
  // navigates fine if any of it never runs.

  const fine = () => window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Tilt — the portrait leans toward the pointer, and relaxes back on leave.
  const initTilt = () => {
    if (!fine() || reduced()) return;
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      const max = 9;
      el.addEventListener("pointermove", (e) => {
        const rect = el.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        el.style.setProperty("--rx", `${(-py * max).toFixed(2)}deg`);
        el.style.setProperty("--ry", `${(px * max).toFixed(2)}deg`);
        el.style.setProperty("--sx", `${(px * 100 + 50).toFixed(1)}%`);
        el.style.setProperty("--sy", `${(py * 100 + 50).toFixed(1)}%`);
      });
      el.addEventListener("pointerleave", () => {
        el.style.setProperty("--rx", "0deg");
        el.style.setProperty("--ry", "0deg");
      });
    });
  };

  // Count-up — stat figures tick from 0 to their value the first time they
  // scroll into view. Reduced motion skips straight to the final number.
  const initCounters = () => {
    const counters = document.querySelectorAll<HTMLElement>("[data-count]");
    if (!counters.length) return;

    const format = (n: number) => Math.round(n).toLocaleString("en-US");
    // The final value is server-rendered so the figure is correct without JS;
    // the count only rewinds to 0 here, at the moment it starts animating.
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count ?? 0);
      if (reduced() || !Number.isFinite(target)) {
        el.textContent = format(target);
        return;
      }
      el.textContent = "0";
      const duration = 1400;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 4);
        el.textContent = format(target * eased);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (!("IntersectionObserver" in window)) {
      counters.forEach(run);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          run(entry.target as HTMLElement);
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    counters.forEach((el) => io.observe(el));
  };

  // Cursor glow — a large soft light that trails the pointer across the page.
  // Lerped in rAF so it feels weighty rather than glued to the cursor.
  let glowRaf = 0;
  const initCursorGlow = () => {
    const glow = document.querySelector<HTMLElement>(".cursor-glow");
    if (!glow || !fine() || reduced()) return;

    let tx = window.innerWidth / 2;
    let ty = window.innerHeight / 3;
    let x = tx;
    let y = ty;

    window.addEventListener(
      "pointermove",
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        glow.classList.add("is-active");
      },
      { passive: true },
    );

    const loop = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      glow.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      glowRaf = requestAnimationFrame(loop);
    };
    cancelAnimationFrame(glowRaf);
    loop();
  };

  // Section dock — highlights whichever section is closest to the top of the viewport.
  const initDock = () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-dock-link]")];
    if (!links.length || !("IntersectionObserver" in window)) return;
    const targets = links.map((l) => document.getElementById(l.dataset.dockLink!)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => links.forEach((l) => l.classList.toggle("is-active", l.dataset.dockLink === id));
    const io = new IntersectionObserver(
      (entries) => {
        // Prefer the entry nearest the top among those intersecting.
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-35% 0px -55% 0px", threshold: 0 },
    );
    targets.forEach((t) => io.observe(t));
    links.forEach((l) =>
      l.addEventListener("click", (e) => {
        e.preventDefault();
        const target = document.getElementById(l.dataset.dockLink!);
        if (!target) return;
        if (window.lenis) window.lenis.scrollTo(target, { offset: -88 });
        else target.scrollIntoView({ behavior: reduced() ? "auto" : "smooth" });
        history.replaceState(null, "", `#${l.dataset.dockLink}`);
      }),
    );
  };

  // FAQ accordion — <details> does the work; this only animates the height
  // and keeps a single item open at a time.
  const initFaq = () => {
    const items = [...document.querySelectorAll<HTMLDetailsElement>("[data-faq] details")];
    items.forEach((el) => {
      const summary = el.querySelector<HTMLElement>("summary")!;
      const body = el.querySelector<HTMLElement>(".faq-a")!;
      summary.addEventListener("click", (e) => {
        e.preventDefault();
        if (reduced()) {
          el.open = !el.open;
          items.forEach((o) => o !== el && (o.open = false));
          return;
        }
        if (el.open) {
          const h = body.offsetHeight;
          body.animate([{ height: `${h}px`, opacity: 1 }, { height: "0px", opacity: 0 }], { duration: 260, easing: "ease" }).onfinish = () => {
            el.open = false;
          };
          return;
        }
        items.forEach((o) => o !== el && o.open && o.querySelector<HTMLElement>("summary")!.click());
        el.open = true;
        const h = body.offsetHeight;
        body.animate([{ height: "0px", opacity: 0 }, { height: `${h}px`, opacity: 1 }], { duration: 320, easing: "cubic-bezier(0.16, 1, 0.3, 1)" });
      });
    });
  };

  // Contact card: inline copy button with a morph to a check mark, and a
  // composer that hands the note to the visitor's mail app via mailto:.
  const initContact = () => {
    const copy = document.querySelector<HTMLButtonElement>("[data-contact-copy]");
    let copyTimer = 0;
    copy?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.contactCopy ?? "");
        copy.classList.add("is-copied");
        window.clearTimeout(copyTimer);
        copyTimer = window.setTimeout(() => copy.classList.remove("is-copied"), 1800);
      } catch {
        window.dispatchEvent(new CustomEvent("toast", { detail: "Couldn't copy — select it instead" }));
      }
    });

    const form = document.querySelector<HTMLFormElement>("[data-composer]");
    if (!form) return;
    const textarea = form.querySelector<HTMLTextAreaElement>("textarea")!;
    const count = form.querySelector<HTMLElement>("[data-composer-count]")!;
    const max = Number(textarea.maxLength) || 1200;

    // Grow with the text instead of scrolling inside a small box.
    const autosize = () => {
      textarea.style.height = "auto";
      textarea.style.height = `${textarea.scrollHeight}px`;
    };
    const updateCount = () => {
      const n = textarea.value.length;
      count.textContent = `${n} / ${max}`;
      count.classList.toggle("is-near", n > max * 0.9);
    };
    textarea.addEventListener("input", () => {
      autosize();
      updateCount();
    });
    autosize();
    updateCount();

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const topic = String(data.get("topic") ?? "");
      const name = String(data.get("name") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();
      if (!message) {
        textarea.focus();
        form.classList.add("is-shaking");
        setTimeout(() => form.classList.remove("is-shaking"), 400);
        return;
      }
      const subject = `${topic}${name ? ` — from ${name}` : ""}`;
      const body = `${message}\n\n${name ? `— ${name}` : ""}`.trim();
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.dispatchEvent(new CustomEvent("toast", { detail: "Opening your mail app…" }));
    });
  };

  document.addEventListener("astro:page-load", () => {
    initContact();
    initFaq();
    initTilt();
    initCounters();
    initCursorGlow();
    initDock();
  });
</script>

<style>
  /* ───────────── Scale ─────────────
     The landing page runs a larger type scale than the reading pages, so the
     tokens are re-based here rather than touching the global ones. */
  .landing {
    --lp-text: 1rem;
    --lp-text-sm: 0.875rem;
    --lp-text-xs: 0.75rem;
    font-size: var(--lp-text);
    line-height: 1.65;
  }

  .landing p {
    max-width: 62ch;
    letter-spacing: -0.01em;
  }

  .landing h2,
  .landing h3 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .landing h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.1;
    margin: 0;
  }

  .landing h3 {
    font-size: 1.15rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  /* The italic serif accent word inside the headline (h2 em is global). */
  .landing h1 .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--accent);
    padding-right: 0.06em;
  }

  .kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.75;
    margin-bottom: 0.75rem;
  }

  .section-head {
    margin-bottom: 2.25rem;
  }

  .section-head.compact {
    margin-bottom: 1.25rem;
  }

  .section-head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
    transition: color var(--transition-base);
    white-space: nowrap;
  }

  .text-link::after {
    display: none;
  }

  .text-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--transition-base);
  }

  .text-link:hover {
    color: var(--text-color);
  }

  .text-link:hover svg {
    transform: translateX(3px);
  }

  :global(.landing-section) {
    margin: 6.5rem 0;
    scroll-margin-top: 5rem;
  }

  /* ───────────── Buttons ───────────── */
  .btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.35rem;
    border-radius: 999px;
    font-size: var(--lp-text-sm);
    font-weight: 500;
    color: var(--text-color);
    white-space: nowrap;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background var(--transition-base),
      border-color var(--transition-base);
  }

  .btn::after {
    display: none;
  }

  .btn svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--transition-base);
  }

  .btn-primary {
    color: #fff;
    background: var(--accent-gradient);
    background-size: 200% 200%;
    animation: gradient-shift 8s ease infinite;
  }

  .btn-primary:hover {
    animation-duration: 3s;
  }

  .btn-primary:hover svg {
    transform: translateX(3px);
  }

  .btn-ghost {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-highlight);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  .btn-ghost:hover {
    background: var(--glass-bg-strong);
    border-color: var(--glass-border-strong);
  }

  .btn-lg {
    padding: 1rem 1.6rem;
    font-size: var(--lp-text);
  }

  /* ───────────── Hero ───────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    /* Fills the first screen, but stops growing on very tall monitors. */
    min-height: min(calc(100vh - 8rem), 52rem);
    padding: 3rem 0 4rem;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The hero drifts up and fades as it leaves, giving the stats bar a stage. */
      .hero-copy,
      .hero-visual {
        animation: hero-exit linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: var(--lp-text-sm);
    color: var(--text-muted);
  }

  .eyebrow-sep {
    opacity: 0.4;
  }

  /* Availability badge: a neutral glass capsule with a live indicator on the
     left and a call-to-action on the right. The whole thing links to contact. */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border-strong);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--text-color);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
    transition: border-color var(--transition-base), background var(--transition-base), transform var(--transition-base);
  }

  /* Indicator: a green core with a soft halo and an expanding ping ring. */
  .status-dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: rgba(74, 222, 128, 0.14);
    border: 1px solid rgba(74, 222, 128, 0.25);
  }

  .status-dot::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.18);
  }

  .status-dot::after {
    content: "";
    position: absolute;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid var(--success);
    animation: pulse-ring 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .status-text {
    padding-top: 0.05rem;
  }

  .headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 6.2vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    row-gap: 0.05em;
  }

  /* Each word rises out of its own clipping box. */
  .word-clip {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .word {
    display: inline-block;
    animation: word-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(120ms + var(--i, 0) * 70ms);
    transform-origin: left bottom;
  }

  .role-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: var(--lp-text-sm);
    color: var(--text-muted);
  }

  .role-name {
    color: var(--text-color);
    font-weight: 500;
  }

  .role-sep {
    opacity: 0.4;
  }

  .lede {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-label {
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    margin-right: 0.35rem;
    opacity: 0.8;
  }

  .social-link {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-muted);
    transition: color var(--transition-base), border-color var(--transition-base), transform var(--transition-base),
      background var(--transition-base);
  }

  .social-link::after {
    display: none;
  }

  .social-link svg {
    width: 1rem;
    height: 1rem;
  }

  .social-link:hover {
    color: var(--text-color);
    border-color: var(--glass-border-strong);
    background: var(--glass-bg-strong);
    transform: translateY(-2px);
  }

  /* Portrait */
  .hero-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 380px);
  }

  .portrait-frame {
    position: relative;
    perspective: 1200px;
    --rx: 0deg;
    --ry: 0deg;
    --sx: 50%;
    --sy: 50%;
  }

  .portrait {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 1;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0.5rem;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-xl) - 0.5rem);
    /* Lifts the flat illustration slightly off the glass. */
    filter: saturate(1.05) contrast(1.02);
  }

  /* A specular highlight that follows the pointer across the glass. */
  .portrait-shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--sx) var(--sy),
      rgba(255, 255, 255, 0.14),
      rgba(255, 255, 255, 0.03) 30%,
      transparent 60%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .float-badge {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.7rem 0.95rem;
    border-radius: 1rem;
    /* Opaque enough to read as a chip floating over the portrait, not a hole in it. */
    background: rgba(17, 17, 17, 0.7);
    border-color: var(--glass-border-strong);
    animation: float 6s ease-in-out infinite;
    white-space: nowrap;
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.8;
  }

  .badge-value {
    font-size: var(--lp-text-sm);
    font-weight: 500;
  }

  .badge-now {
    top: 8%;
    left: -12%;
  }

  .badge-stack {
    bottom: 10%;
    right: -10%;
    animation-delay: -3s;
  }

  /* ───────────── Stats ───────────── */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.6rem 1.75rem;
    border-right: 1px solid var(--glass-border);
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat-value {
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .stat-suffix {
    color: var(--accent);
    margin-left: 0.05em;
  }

  .stat-label {
    font-size: var(--lp-text-sm);
    color: var(--text-muted);
  }

  /* ───────────── Marquee ───────────── */
  .marquee {
    margin: 2.5rem 0 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    animation: marquee 40s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--lp-text-sm);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.7;
    white-space: nowrap;
  }

  .marquee-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ───────────── Spotlight cards ───────────── */
  [data-spotlight] {
    position: relative;
    overflow: hidden;
    --mx: 50%;
    --my: 50%;
  }

  [data-spotlight]::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(380px circle at var(--mx) var(--my), rgba(167, 139, 250, 0.12), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  [data-spotlight]:hover::before {
    opacity: 1;
  }

  /* Card content must sit above the spotlight layer. */
  [data-spotlight] > * {
    position: relative;
  }

  /* ───────────── Services ───────────── */
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .service {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color var(--transition-base);
  }

  .service:hover {
    transform: translateY(-4px);
    border-color: var(--glass-border-strong);
  }

  .service-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1.25rem;
    border-radius: 0.85rem;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  .service-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .service p {
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
    margin-bottom: 1.25rem;
  }

  /* ───────────── Tags ───────────── */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    padding: 0.28rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
  }

  /* ───────────── Projects ───────────── */
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  /* Bento: the first project spans the full row. */
  .project:first-child {
    grid-column: 1 / -1;
  }

  .project {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    color: var(--text-color);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color var(--transition-base);
  }

  .project::after {
    display: none;
  }

  .project:hover {
    transform: translateY(-4px);
    border-color: var(--glass-border-strong);
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    opacity: 0.7;
  }

  .project-arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base),
      border-color var(--transition-base);
  }

  .project-arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .project:hover .project-arrow {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
    transform: rotate(45deg);
  }

  .project h3 {
    font-size: 1.35rem;
  }

  .project:first-child h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    max-width: 24ch;
  }

  .project p {
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  /* ───────────── Timeline ───────────── */
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* The spine. Drawn top-to-bottom as the list scrolls through the viewport. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(11rem + 0.5rem);
    width: 1px;
    background: var(--accent-border);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::before {
        animation: draw-y linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 55%;
      }
    }
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .timeline-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    padding-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .timeline-to {
    opacity: 0.5;
  }

  .timeline-dot {
    position: relative;
    width: 0.65rem;
    height: 0.65rem;
    margin-top: 1.55rem;
    margin-left: 0.2rem;
    border-radius: 50%;
    background: var(--bg-color);
    border: 1px solid var(--accent);
    box-shadow: 0 0 0 4px var(--bg-color);
  }

  .timeline-dot.current {
    background: var(--accent);
  }

  .timeline-dot.current::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse-ring 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .timeline-card {
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-card:hover {
    border-color: var(--glass-border-strong);
    transform: translateX(4px);
  }

  .timeline-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .timeline-title h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .timeline-company {
    font-size: var(--lp-text-sm);
    color: var(--text-muted);
  }

  .timeline-company::before {
    content: "@ ";
    opacity: 0.5;
  }

  .pill-now {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  .timeline-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  /* ───────────── Principles ───────────── */
  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--glass-border);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--bg-color);
    background: color-mix(in srgb, var(--bg-color) 85%, transparent);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    transition: background var(--transition-base);
  }

  .principle:hover {
    background: var(--glass-bg-strong);
  }

  .principle-index {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--accent);
  }

  .principle p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  /* ───────────── Skills ───────────── */
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: start;
    gap: 1rem;
  }

  .skill-group + .skill-group {
    padding-top: 1.25rem;
    border-top: 1px solid var(--glass-border);
  }

  .skill-category {
    font-size: var(--lp-text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    opacity: 0.7;
    padding-top: 0.5rem;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Capsules: the radius is deliberately larger than any possible height, so
     the ends stay perfectly semicircular no matter the label length. */
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.4rem 0.95rem;
    font-size: var(--lp-text-sm);
    line-height: 1;
    white-space: nowrap;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    transition: border-color var(--transition-base), background var(--transition-base), color var(--transition-base),
      transform var(--transition-base);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip:hover {
      border-color: var(--accent-border);
      background: var(--accent-soft);
      color: var(--accent);
      transform: translateY(-2px);
    }
  }

  /* ───────────── Writing ───────────── */
  .posts {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--glass-border);
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-color);
    border-radius: 0.5rem;
    transition: background var(--transition-base), padding var(--transition-base);
  }

  .post::after {
    display: none;
  }

  .post:hover {
    background: var(--glass-bg);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .post h3 {
    margin-bottom: 0.3rem;
    transition: color var(--transition-base);
  }

  .post p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .post time {
    font-family: var(--font-mono);
    font-size: var(--lp-text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .post-arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  .post-arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .post:hover .post-arrow {
    background: var(--text-color);
    color: var(--bg-color);
    transform: translateX(3px);
  }

  /* ───────────── FAQ ───────────── */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem;
    align-items: start;
  }

  .faq-head {
    position: sticky;
    top: 6rem;
    margin-bottom: 0;
  }

  .faq-lede {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
    max-width: 30ch;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base);
  }

  .faq-item[open],
  .faq-item:hover {
    border-color: var(--glass-border-strong);
  }

  .faq-q {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-index {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--accent);
  }

  .faq-chevron {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background var(--transition-base), color var(--transition-base);
  }

  .faq-chevron svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(45deg);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .faq-a {
    overflow: hidden;
    padding: 0 1.35rem;
  }

  .faq-a p {
    margin: 0;
    padding: 0 0 1.35rem 2.35rem;
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
  }

  /* ───────────── Contact ───────────── */
  .contact {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    overflow: hidden;
    /* Reset the shared spotlight so the border glow below can own --mx/--my. */
    --mx: 50%;
    --my: 50%;
  }

  /* Border glow that follows the pointer: a gradient layer masked to the 1px
     edge of the card, so only the border lights up near the cursor. */
  /* Specific enough to beat `[data-spotlight] > *`, which would otherwise pull
     this layer into the grid as a cell. */
  .contact .contact-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(167, 139, 250, 0.9), transparent 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .contact:hover .contact-glow {
    opacity: 1;
  }

  /* The card's own spotlight is softer than the default so the form stays legible. */
  .contact::before {
    background: radial-gradient(520px circle at var(--mx) var(--my), rgba(167, 139, 250, 0.07), transparent 45%);
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    max-width: 14ch;
    margin: 0 0 1rem;
  }

  .contact-desc {
    color: var(--text-muted);
    margin: 0 0 1.75rem;
    max-width: 40ch;
  }

  /* Email row */
  .contact-email {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    min-width: 0;
  }

  .contact-email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--text-color);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    letter-spacing: -0.01em;
  }

  .contact-email-link::after {
    display: none;
  }

  .contact-email-at {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    font-size: 0.85rem;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-email-link:hover .contact-email-at {
    transform: rotate(-12deg) scale(1.08);
  }

  .contact-email-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Underline slides in from the left on hover. */
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left bottom / 0 1px;
    transition: background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 1px;
  }

  .contact-email-link:hover .contact-email-text {
    background-size: 100% 1px;
  }

  .contact-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-muted);
    font-size: var(--lp-text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--transition-base), background var(--transition-base), color var(--transition-base);
  }

  .contact-copy svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .contact-copy-check {
    display: none;
  }

  .contact-copy:hover {
    border-color: var(--glass-border-strong);
    color: var(--text-color);
  }

  .contact-copy.is-copied {
    border-color: rgba(74, 222, 128, 0.5);
    background: rgba(74, 222, 128, 0.1);
    color: #bbf7d0;
  }

  .contact-copy.is-copied .contact-copy-icon {
    display: none;
  }

  .contact-copy.is-copied .contact-copy-check {
    display: block;
    animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
    transform: none !important;
  }

  .contact-copy.is-copied .contact-copy-label::after {
    content: "ied";
  }

  .contact-copy.is-copied .contact-copy-label {
    /* "Copy" → "Copied" without a layout jump. */
    display: inline-block;
    min-width: 2.6em;
  }

  /* Meta list */
  .contact-meta {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--lp-text-sm);
    color: var(--text-muted);
  }

  .contact-meta li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
  }

  .contact-meta li::before {
    content: "";
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--glass-border-strong);
    flex: none;
  }

  .contact-meta li:has(.contact-meta-dot)::before {
    display: none;
  }

  .contact-meta-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    flex: none;
    margin-left: -0.1rem;
  }

  .contact-meta-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--success);
    animation: pulse-ring 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* Socials */
  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .contact-social {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-muted);
    font-size: var(--lp-text-sm);
    transition: border-color var(--transition-base), color var(--transition-base), background var(--transition-base),
      transform var(--transition-base);
  }

  .contact-social::after {
    display: none;
  }

  .contact-social svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .contact-social-arrow {
    opacity: 0.5;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .contact-social:hover {
    color: var(--text-color);
    border-color: var(--glass-border-strong);
    background: var(--glass-bg-strong);
    transform: translateY(-2px);
  }

  .contact-social:hover .contact-social-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* Composer */
  .composer {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    background: rgba(0, 0, 0, 0.22);
    min-width: 0;
  }

  .composer.is-shaking {
    animation: composer-shake 0.4s ease;
  }

  @keyframes composer-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
