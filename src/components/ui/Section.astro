---
interface Props {
  class?: string;
  id?: string;
}

const { class: className, id } = Astro.props;
---

<section class:list={["section", className]} id={id}>
  <slot />
</section>

<style>
  .section {
    margin: 4rem 0;
  }

  @media (max-width: 640px) {
    .section {
      margin: 3rem 0;
    }
  }
</style>
