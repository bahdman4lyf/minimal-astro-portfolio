---
import "../../styles/theme.css";
import "../../styles/animations.css";
import "../../styles/global.css";

import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/roboto-mono/400.css";
import "@fontsource-variable/syne";
import "@fontsource/instrument-serif";
import "@fontsource/instrument-serif/400-italic.css";
import "lenis/dist/lenis.css";

import interLightWoff2 from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";
import interRegularWoff2 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interMediumWoff2 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import robotoMonoRegularWoff2 from "@fontsource/roboto-mono/files/roboto-mono-latin-400-normal.woff2?url";
import syneWoff2 from "@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url";
import instrumentSerifItalicWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";
import Navigation from "../shared/Navigation.astro";
import CommandPalette from "../shared/CommandPalette.astro";
import NowPlaying from "../shared/NowPlaying.astro";
import Toast from "../shared/Toast.astro";
import Background from "./Background.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  siteName?: string;
  /** Widens the content column — used by the landing page only. */
  wide?: boolean;
}

interface SocialLink {
  url: string;
}

const {
  title,
  description,
  image = "/images/og-image.jpg",
  canonicalURL = Astro.url,
  siteName,
  wide = false,
} = Astro.props;

// Crawlers require an absolute og:image URL. `Astro.site` is only defined once
// `site` is set in astro.config.ts — until then fall back to the relative path,
// because resolving against Astro.url would bake in a localhost origin at build.
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;

// og:site_name is the brand behind every page, so it comes from the site config
// rather than the per-page title. Falls back to the hostname if the config is
// ever missing, since an empty value would be worse than none.
const brand = await getEntry("site", "home");
const ogSiteName = siteName ?? brand?.data.seoName ?? brand?.data.name ?? Astro.site?.hostname ?? "Portfolio";
const pageTitle = title.includes(ogSiteName) ? title : `${title} | ${ogSiteName}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : canonicalURL;
const personSchema = brand?.data.contact
  ? {
      "@context": "https://schema.org",
      "@type": "Person",
      name: ogSiteName,
      url: Astro.site?.href,
      jobTitle: brand.data.title,
      description: brand.data.introduction,
      email: `mailto:${brand.data.contact.email}`,
      homeLocation: brand.data.contact.location ? { "@type": "Place", name: brand.data.contact.location } : undefined,
      sameAs: brand.data.socialLinks?.map((link: SocialLink) => link.url),
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#111111" />

    <!-- Preload critical fonts -->
    <link rel="preload" href={interLightWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interMediumWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={robotoMonoRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={syneWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={instrumentSerifItalicWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Hero portrait is served live from GitHub. -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <!-- Declaring dimensions lets crawlers reserve the card before fetching. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${description}`} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {personSchema && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script is:inline>
      // Always use dark theme
      document.documentElement.setAttribute("data-theme", "dark");

      // Marks JS as available so scroll-reveal can hide its targets. Set here,
      // before first paint, so revealed content never flashes in then out.
      document.documentElement.classList.add("js");

      // Handle theme persistence during view transitions
      document.addEventListener("astro:before-swap", (ev) => {
        ev.newDocument.documentElement.setAttribute("data-theme", "dark");
      });

      // Add initial-load class
      document.addEventListener("DOMContentLoaded", () => {
        document.body.classList.add("initial-load");

        setTimeout(() => {
          document.body.classList.remove("initial-load");
          document.documentElement.classList.add("theme-transition");
        }, 1000);
      });
    </script>
  </head>
  <body>
    <Background transition:persist />
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class:list={["site", { wide }]}>
      <div class="nav-container">
        <Navigation />
      </div>
      <main><slot /></main>
    </div>
    <CommandPalette transition:persist />
    <NowPlaying transition:persist />
    <Toast transition:persist />

    <script>
      import Lenis from "lenis";

      // Smooth, inertial scrolling. Lenis drives the native scroll position, so
      // sticky elements, anchors and CSS scroll-driven animations keep working.
      // Skipped entirely for users who asked for reduced motion.
      declare global {
        interface Window {
          __portfolioLenis?: Lenis;
        }
      }
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ lerp: 0.09, wheelMultiplier: 0.95, anchors: { offset: -88 } });
        window.__portfolioLenis = lenis;
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // New page, new document height.
        document.addEventListener("astro:page-load", () => lenis.resize());
        // Freeze the page behind the palette without fighting Lenis's own scroll.
        new MutationObserver(() => {
          document.documentElement.classList.contains("palette-open") ? lenis.stop() : lenis.start();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
      }
    </script>

    <script>
      // Held at module scope on purpose. An IntersectionObserver whose only
      // reference is a local variable can be garbage collected once the function
      // returns — it then silently stops delivering entries, which strands every
      // not-yet-revealed element at opacity 0 forever.
      let observer: IntersectionObserver | null = null;
      let pending: Element[] = [];
      let lastSweep = 0;

      const reveal = (el: Element) => {
        el.classList.add("is-revealed");
        if (observer) observer.unobserve(el);
      };

      // Same test the observer makes, done by hand.
      const isInView = (el: Element) => el.getBoundingClientRect().top < window.innerHeight * 0.92;

      // Backstop for the observer: a missed observer callback can never leave
      // content invisible. Deliberately not driven by requestAnimationFrame —
      // that ties it to the render loop, which is exactly what fails when the
      // observer is already not delivering.
      const sweep = () => {
        pending = pending.filter((el) => {
          if (el.classList.contains("is-revealed")) return false;
          if (!isInView(el)) return true;
          reveal(el);
          return false;
        });

        if (!pending.length) {
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
        }
      };

      // Throttled to ~10/sec over a list that only shrinks, so the rect reads
      // stay well inside a frame's budget.
      const onScroll = () => {
        const now = Date.now();
        if (now - lastSweep < 100) return;
        lastSweep = now;
        sweep();
      };

      const revealTargets = () => {
        const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)')];
        if (!targets.length) return;

        // No observer support (or reduced motion) — show everything at once.
        if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          targets.forEach((el) => el.classList.add("is-revealed"));
          return;
        }

        const currentObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              // Reveal is one-way; `reveal` unobserves so scrolling stays cheap.
              if (entry.isIntersecting) reveal(entry.target);
            });
          },
          // Fire slightly before the element reaches the fold, and accept the
          // thinnest sliver of visibility so short rows at the edge still count.
          { rootMargin: "0px 0px -8% 0px", threshold: 0.01 },
        );
        observer = currentObserver;

        targets.forEach((el) => currentObserver.observe(el));

        pending = targets;
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        // Catch anything already on screen, including a restored scroll position.
        sweep();
      };

      // Shared micro-interactions. All decorative; the page works without them.
      const fine = () => window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Spotlight — a radial highlight on glass cards that tracks the pointer.
      // Coordinates are written as CSS variables; the gradient itself lives in CSS.
      const initSpotlight = () => {
        if (!fine()) return;
        document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
          if (card.dataset.spotlightReady) return;
          card.dataset.spotlightReady = "1";
          card.addEventListener("pointermove", (e: PointerEvent) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            card.style.setProperty("--my", `${e.clientY - rect.top}px`);
          });
        });
      };

      // Magnetic buttons — nudge toward the pointer, spring back on leave.
      const initMagnetic = () => {
        if (!fine() || reduced()) return;
        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
          if (el.dataset.magneticReady) return;
          el.dataset.magneticReady = "1";
          el.addEventListener("pointermove", (e: PointerEvent) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * 0.18;
            const y = (e.clientY - r.top - r.height / 2) * 0.28;
            el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
          });
          el.addEventListener("pointerleave", () => {
            el.style.transform = "";
          });
        });
      };

      // Copy-to-clipboard buttons announce through the shared toast.
      const initCopy = () => {
        document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
          if (btn.dataset.copyReady) return;
          btn.dataset.copyReady = "1";
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(btn.dataset.copy ?? "");
              window.dispatchEvent(new CustomEvent("toast", { detail: "Copied to clipboard" }));
            } catch {
              window.dispatchEvent(new CustomEvent("toast", { detail: "Couldn't copy — select it instead" }));
            }
          });
        });
      };

      // Nav firms up once the page has scrolled past the top.
      const syncScrolled = () => {
        document.documentElement.classList.toggle("scrolled", window.scrollY > 24);
      };
      window.addEventListener("scroll", syncScrolled, { passive: true });

      // Fires on first load and after every view transition.
      document.addEventListener("astro:page-load", () => {
        revealTargets();
        syncScrolled();
        initSpotlight();
        initMagnetic();
        initCopy();
      });
    </script>

    <style>
      /* Thin read-position bar. Driven by the scroll timeline where supported,
         and simply absent elsewhere — it is decoration, not navigation. */
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        z-index: 60;
        background: var(--accent);
        transform-origin: left;
        transform: scaleX(0);
        pointer-events: none;
      }

      @supports (animation-timeline: scroll()) {
        .scroll-progress {
          animation: grow-x linear both;
          animation-timeline: scroll(root);
        }
      }
    </style>
  </body>
</html>
