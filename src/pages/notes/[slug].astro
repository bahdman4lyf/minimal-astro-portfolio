---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import ArticleLayout from "../../components/layout/ArticleLayout.astro";

export const getStaticPaths = (async () => {
  const notes = (await getCollection("notes", ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
---

<ArticleLayout
  title={note.data.title}
  description={note.data.description}
  date={note.data.publishedAt}
  kicker={`Notes · ${note.data.category}`}
  backHref="/notes"
  backLabel="All notes"
  body={note.body}
  prev={older && { title: older.data.title, href: `/notes/${older.id}` }}
  next={newer && { title: newer.data.title, href: `/notes/${newer.id}` }}
>
  <Content />
</ArticleLayout>
