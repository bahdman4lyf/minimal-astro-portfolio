---
// Shared frame for a blog post or note: kicker, title, reading meta, share
// action, the rendered body, and prev/next navigation.
import BaseLayout from "./BaseLayout.astro";
import Container from "../ui/Container.astro";
import { getEntry } from "astro:content";

interface Neighbour {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  kicker: string;
  backHref: string;
  backLabel: string;
  /** Raw markdown body, used to estimate reading time. */
  body?: string;
  prev?: Neighbour;
  next?: Neighbour;
}

const { title, description, date, kicker, backHref, backLabel, body = "", prev, next } = Astro.props;

const words = body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 220));

const formatDate = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const site = await getEntry("site", "home");
const author = site?.data.seoName ?? site?.data.name ?? "Author";
const origin = Astro.site?.href ?? "/";
const pageUrl = new URL(Astro.url.pathname, origin).href;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    wordCount: words,
    timeRequired: `PT${readingMinutes}M`,
    inLanguage: "en",
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    url: pageUrl,
    image: new URL("/images/og-image.png", origin).href,
    author: { "@type": "Person", name: author, url: origin },
    publisher: { "@type": "Person", name: author, url: origin },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin },
      { "@type": "ListItem", position: 2, name: backLabel, item: new URL(backHref, origin).href },
      { "@type": "ListItem", position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} type="article" publishedAt={date} {schema}>
  <Container>
    <article class="article">
      <header class="article-head">
        <a href={backHref} class="back" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5m0 0 6 6m-6-6 6-6" />
          </svg>
          {backLabel}
        </a>
        <span class="kicker" data-reveal style="--reveal-delay: 40ms">{kicker}</span>
        <h1 data-reveal style="--reveal-delay: 80ms">{title}</h1>
        <p class="lede" data-reveal style="--reveal-delay: 120ms">{description}</p>
        <div class="meta glass" data-reveal style="--reveal-delay: 160ms">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>{readingMinutes} min read</span>
          <button type="button" class="share" data-copy-link>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" />
            </svg>
            Copy link
          </button>
        </div>
      </header>

      <div class="content" data-reveal style="--reveal-delay: 220ms">
        <slot />
      </div>

      {
        (prev || next) && (
          <nav class="pager" aria-label="More">
            {prev ? (
              <a href={prev.href} class="pager-link glass" data-spotlight data-reveal>
                <span class="pager-dir">← Previous</span>
                <span class="pager-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={next.href} class="pager-link pager-next glass" data-spotlight data-reveal>
                <span class="pager-dir">Next →</span>
                <span class="pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </Container>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async () => {
      const url = location.href.split("#")[0];
      try {
        if (navigator.share && /Mobi|Android/i.test(navigator.userAgent)) {
          await navigator.share({ title: document.title, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        window.dispatchEvent(new CustomEvent("toast", { detail: "Link copied" }));
      } catch {
        /* user dismissed the share sheet — nothing to report */
      }
    });
  });
</script>

<style>
  .article {
    padding: 1.5rem 0 3rem;
  }

  .article-head {
    margin-bottom: 2.5rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .back::after {
    display: none;
  }

  .back svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--transition-base);
  }

  .back:hover {
    color: var(--text-color);
  }

  .back:hover svg {
    transform: translateX(-3px);
  }

  .kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.75;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    line-height: 1.1;
    margin-bottom: 0.9rem;
    text-wrap: balance;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.5rem 0.45rem 1rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .meta-sep {
    opacity: 0.4;
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-color);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    transition: border-color var(--transition-base), background var(--transition-base);
  }

  .share svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .share:hover {
    border-color: var(--accent-border);
    background: var(--accent-soft);
  }

  /* Rendered markdown */
  .content {
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
    font-size: var(--text-2xl);
  }

  .content :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    font-size: var(--text-xl);
  }

  .content :global(p) {
    margin-bottom: 1.25rem;
    max-width: 100%;
  }

  .content :global(a) {
    color: var(--accent);
  }

  .content :global(img) {
    border-radius: 0.75rem;
    margin: 1.75rem 0;
    border: 1px solid var(--glass-border);
  }

  .content :global(blockquote) {
    border-left: 2px solid var(--accent-border);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.75rem 0;
    color: var(--text-muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15em;
  }

  .content :global(pre) {
    padding: 1.1rem 1.25rem;
    border-radius: 0.85rem;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03) !important;
    overflow-x: auto;
    margin: 1.75rem 0;
    max-width: 100%;
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .content :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 0.35rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.4rem;
  }

  .content :global(li) {
    margin: 0.4rem 0;
  }

  .content :global(li::marker) {
    color: var(--accent);
  }

  .content :global(hr) {
    border-top-color: var(--glass-border);
    margin: 2.5rem 0;
  }

  .content :global(table) {
    font-size: var(--text-sm);
  }

  /* Prev / next */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .pager-link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-lg);
    color: var(--text-color);
    overflow: hidden;
    --mx: 50%;
    --my: 50%;
    transition: border-color var(--transition-base), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pager-link::after {
    display: none;
  }

  .pager-link::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgba(167, 139, 250, 0.12), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .pager-link:hover {
    border-color: var(--glass-border-strong);
    transform: translateY(-2px);
  }

  .pager-link:hover::before {
    opacity: 1;
  }

  .pager-link > * {
    position: relative;
  }

  .pager-next {
    text-align: right;
  }

  .pager-dir {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager-next {
      text-align: left;
    }

    .meta {
      flex-wrap: wrap;
      border-radius: 1rem;
      padding: 0.6rem 0.75rem;
    }
  }
</style>
