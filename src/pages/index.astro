---
import Section from "../components/ui/Section.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import ContentList from "../components/shared/ContentList.astro";
import Container from "../components/ui/Container.astro";
// `?url` makes Vite emit the file as a build asset and hand back its public path.
import resumeUrl from "../assets/docs/Nathaniel Joseph - Frontend- CV.docx?url";

const siteConfig = await getEntry("site", "home");
if (!siteConfig) {
  throw new Error("Site configuration not found");
}

const site = siteConfig.data;

const formatDate = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
};

const formatMonthYear = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
};

// Staggers a list so items cascade in rather than appearing all at once.
const revealDelay = (index: number, step = 70) => `--reveal-delay: ${index * step}ms`;

const posts = await getCollection("blog", ({ data }: CollectionEntry<"blog">) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const latestPosts = posts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  )
  .slice(0, 3);

const experiences = await getCollection("experience");
// Current roles first, then most recently started. Several roles share a start
// month, so fall back to end date to keep the order stable.
const sortedExperiences = experiences.sort((a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) => {
  if (a.data.current !== b.data.current) return a.data.current ? -1 : 1;
  const byStart = b.data.startDate.getTime() - a.data.startDate.getTime();
  if (byStart !== 0) return byStart;
  return (b.data.endDate?.getTime() ?? 0) - (a.data.endDate?.getTime() ?? 0);
});

const projects = await getCollection("projects");
const featuredProjects = projects.filter((project: CollectionEntry<"projects">) => project.data.featured).slice(0, 3);

const education = [...(site.education ?? [])].sort((a, b) => b.startDate.getTime() - a.startDate.getTime());
---

<BaseLayout title={`${site.name} - Portfolio`} description={site.introduction}>
  <Container>
    <section class="hero">
      <h1 data-reveal>{site.name}</h1>
      <p class="subtitle" data-reveal style={revealDelay(1)}>{site.title}</p>
      <p class="introduction" data-reveal style={revealDelay(2)}>{site.introduction}</p>
      {
        site.socialLinks && (
          <div class="social-links" data-reveal style={revealDelay(3)}>
            {site.socialLinks.map(({ platform, url }) => (
              <a href={url} target="_blank" rel="noopener noreferrer">
                {platform}
              </a>
            ))}
          </div>
        )
      }
    </section>

    <Section>
      <div class="section-header" data-reveal>
        <h2>{site.sections.blog.title}</h2>
        <a href="/blog">{site.sections.blog.viewAllText}</a>
      </div>
      <ContentList>
        {
          latestPosts.map((post, i) => (
            <article data-reveal style={revealDelay(i)}>
              <div class="title-row">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                {post.data.publishedAt && (
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                )}
              </div>
              <p class="muted-text">{post.data.description}</p>
            </article>
          ))
        }
      </ContentList>
    </Section>

    <Section>
      <div class="section-header" data-reveal>
        <h2>{site.sections.projects.title}</h2>
        <!-- <a href="/projects">{site.sections.projects.viewAllText}</a> -->
      </div>
      <ContentList>
        {
          featuredProjects.map((project, i) => (
            <article data-reveal style={revealDelay(i)}>
              <div class="title-row">
                <a href={project.data.url} target="_blank" rel="noopener noreferrer">
                  {project.data.title}
                </a>
              </div>
              <p class="muted-text">{project.data.description}</p>
              {project.data.techs && (
                <div class="tags">
                  {project.data.techs.map((tech) => (
                    <span>{tech}</span>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </ContentList>
    </Section>

    <Section>
      <div class="section-header" data-reveal>
        <h2>{site.sections.experience.title}</h2>
        <a href={resumeUrl} download="Nathaniel Joseph - Frontend Developer CV.docx">
          {site.sections.experience.viewAllText}
        </a>
      </div>
      <ContentList>
        {
          sortedExperiences.map((exp, i) => (
            <article data-reveal style={revealDelay(i)}>
              <div class="title-row">
                <span class="role">{exp.data.title}</span>
                <time>
                  {formatMonthYear(exp.data.startDate)} -{" "}
                  {exp.data.current ? "Present" : formatMonthYear(exp.data.endDate)}
                </time>
              </div>
              <p class="muted-text">{exp.data.description}</p>
            </article>
          ))
        }
      </ContentList>
    </Section>

    {
      site.skills && site.sections.skills && (
        <Section>
          <div class="section-header" data-reveal>
            <h2>{site.sections.skills.title}</h2>
          </div>
          <div class="skill-groups">
            {site.skills.map((group, i) => (
              <div class="skill-group" data-reveal style={revealDelay(i, 60)}>
                <span class="skill-category">{group.category}</span>
                <div class="skill-items">
                  {group.items.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </Section>
      )
    }

    {
      education.length > 0 && site.sections.education && (
        <Section>
          <div class="section-header" data-reveal>
            <h2>{site.sections.education.title}</h2>
          </div>
          <ContentList>
            {education.map((edu, i) => (
              <article data-reveal style={revealDelay(i)}>
                <div class="title-row">
                  <span class="role">{edu.credential}</span>
                  <time>
                    {formatMonthYear(edu.startDate)} -{" "}
                    {edu.current ? "Present" : formatMonthYear(edu.endDate)}
                  </time>
                </div>
                <p class="muted-text">
                  {edu.school}
                  {edu.location && ` · ${edu.location}`}
                </p>
              </article>
            ))}
          </ContentList>
        </Section>
      )
    }

    {
      site.certifications && site.sections.certifications && (
        <Section>
          <div class="section-header" data-reveal>
            <h2>{site.sections.certifications.title}</h2>
          </div>
          <ContentList>
            {site.certifications.map((cert, i) => (
              <article data-reveal style={revealDelay(i)}>
                <div class="title-row">
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noopener noreferrer">
                      {cert.name}
                    </a>
                  ) : (
                    <span class="role">{cert.name}</span>
                  )}
                  <time>{cert.year}</time>
                </div>
              </article>
            ))}
          </ContentList>
        </Section>
      )
    }

    {
      site.contact && site.sections.contact && (
        <Section>
          <div class="section-header" data-reveal>
            <h2>{site.sections.contact.title}</h2>
          </div>
          <div class="contact" data-reveal style={revealDelay(1)}>
            <p class="muted-text">{site.sections.contact.description}</p>
            <a class="contact-email" href={`mailto:${site.contact.email}`}>
              {site.contact.email}
            </a>
            {site.contact.location && <p class="muted-text contact-location">{site.contact.location}</p>}
          </div>
        </Section>
      )
    }
  </Container>
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .hero {
    padding: 4rem 0;
  }

  .introduction {
    margin: 1.5rem 0;
    opacity: 0.9;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--text-sm);
  }

  .role {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  time {
    font-size: var(--text-xs);
    opacity: 0.5;
    white-space: nowrap;
  }

  .tags {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .tags span {
    font-size: var(--text-xs);
    opacity: 0.5;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    opacity: 0.7;
  }

  /* Skills */
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: start;
    gap: 1rem;
  }

  .skill-category {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.45;
    /* Nudged down so the label sits on the pills' text baseline, not their top edge. */
    padding-top: 0.5rem;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Capsules: the radius is deliberately larger than any possible height, so the
     ends stay perfectly semicircular no matter the label length. */
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.35rem 0.9rem;
    font-size: var(--text-xs);
    line-height: 1;
    white-space: nowrap;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    /* Thin top highlight reads as a raised capsule rather than a flat outline. */
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    transition: border-color var(--transition-base), background var(--transition-base), box-shadow
        var(--transition-base), transform var(--transition-base);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip:hover {
      border-color: rgba(139, 92, 246, 0.55);
      background: linear-gradient(180deg, rgba(139, 92, 246, 0.18), rgba(139, 92, 246, 0.08));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 6px 16px -6px rgba(139, 92, 246, 0.55);
      transform: translateY(-1px);
    }
  }

  /* Contact */
  .contact-email {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: var(--text-lg);
  }

  .contact-location {
    margin-top: 0.75rem;
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem 0;
    }

    .hero {
      padding: 3rem 0;
    }

    .container {
      padding: 0 1rem;
    }

    .skill-group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
