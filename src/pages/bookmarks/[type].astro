---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ArticleCard from "../../components/ui/ArticleCard.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import Categories from "../../components/shared/Categories.astro";
import BaseHero from "../../components/shared/BaseHero.astro";
import Container from "../../components/ui/Container.astro";
import ContentList from "../../components/shared/ContentList.astro";
import ListFilter from "../../components/shared/ListFilter.astro";
type Bookmark = CollectionEntry<"bookmarks">;

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

export const getStaticPaths = (async () => {
  const bookmarks = await getCollection("bookmarks");
  const allTypes = [...new Set(bookmarks.map((bookmark: Bookmark) => bookmark.data.type))];

  return allTypes.map((typePath) => {
    const typeBookmarks = bookmarks.filter((bookmark: Bookmark) => bookmark.data.type === typePath);

    return {
      params: { type: typePath },
      props: { typeBookmarks, allTypes, type: typePath },
    };
  });
}) satisfies GetStaticPaths;

const { typeBookmarks, allTypes, type } = Astro.props;

const sortedBookmarks = typeBookmarks.sort(
  (a: Bookmark, b: Bookmark) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);
---

<BaseLayout title={`${type}s I recommend`} description={`Saved ${type}s worth your time`}>
  <Container>
    <BaseHero
      kicker="Bookmarks"
      title="Saved"
      accent={`${type}s`}
      description={`${type.charAt(0).toUpperCase() + type.slice(1)}s that changed how I build things.`}
      count={sortedBookmarks.length}
      countLabel="saved"
    >
      <ListFilter target="#bookmark-list" />
    </BaseHero>

    <Categories plural categories={allTypes} currentPath={Astro.url.pathname} basePath="bookmarks" />

    <ContentList id="bookmark-list">
      {
        sortedBookmarks.map((bookmark: Bookmark) => (
          <ArticleCard
            title={bookmark.data.title}
            description={bookmark.data.description}
            url={bookmark.data.url}
            date={bookmark.data.createdAt}
            tags={[capitalize(bookmark.data.type), bookmark.data.author]}
          />
        ))
      }
    </ContentList>
  </Container>
</BaseLayout>
