---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Categories from "../../components/shared/Categories.astro";
import ArticleCard from "../../components/ui/ArticleCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseHero from "../../components/shared/BaseHero.astro";
import Container from "../../components/ui/Container.astro";
import ContentList from "../../components/shared/ContentList.astro";
import ListFilter from "../../components/shared/ListFilter.astro";
type Bookmark = CollectionEntry<"bookmarks">;

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const bookmarks = await getCollection("bookmarks");
const types = [...new Set(bookmarks.map((bookmark: Bookmark) => bookmark.data.type))];
const sortedBookmarks = bookmarks.sort(
  (a: Bookmark, b: Bookmark) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);
---

<BaseLayout title="Bookmarks" description="Articles, books and talks worth your time">
  <Container>
    <BaseHero
      kicker="Bookmarks"
      title="Worth"
      accent="your time"
      description="Articles, books and talks that changed how I build things."
      count={sortedBookmarks.length}
      countLabel="saved"
    >
      <ListFilter target="#bookmark-list" />
    </BaseHero>

    <Categories plural categories={types} currentPath={Astro.url.pathname} basePath="bookmarks" />

    <ContentList id="bookmark-list">
      {
        sortedBookmarks.map((bookmark) => (
          <ArticleCard
            title={bookmark.data.title}
            description={bookmark.data.description}
            url={bookmark.data.url}
            date={bookmark.data.createdAt}
            tags={[capitalize(bookmark.data.type), bookmark.data.author]}
          />
        ))
      }
    </ContentList>
  </Container>
</BaseLayout>
